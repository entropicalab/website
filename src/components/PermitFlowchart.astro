---
// interactive map of the municipio de panamá permitting process.
// bilingual (es/en), vanilla (no libraries), same pattern as CostCalculator.
// the client island imports the pure fee model from src/lib/permitFees.ts.
//
// casing: entrópica writes lowercase, and the brand stylesheet enforces
// text-transform: lowercase globally. institutional siglas (RLA, RDP, PDC,
// DOYC, MIVIOT…) and the B/. currency are opted out via text-transform:none
// in the styles so they render as authored.
import type { Locale } from '../i18n/strings';
import { localized } from '../i18n/utils';
import { FIXED_FEES } from '../lib/permitFees';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const DEFAULT_COST_M2 = 1000; // B/. per m², matches the site's stated median
const DEFAULT_AREA = 250; // m²

// entry scenarios: key + icon are language-neutral; labels come from S.
const scenarioKeys = ['vacio', 'demoler', 'renovar', 'urbanizacion'] as const;
type ScnKey = (typeof scenarioKeys)[number];
const scenarioIcons: Record<ScnKey, string> = {
  vacio: 'grass',
  demoler: 'front_loader',
  renovar: 'handyman',
  urbanizacion: 'other_houses',
};

// ventanilla única institution siglas (same in both languages); descriptions in S.
const vuKeys = ['DOYC', 'DINASEPI', 'MINSA', 'MOP', 'MIVIOT', 'IDAAN', 'MIAMBIENTE', 'ATTT'] as const;

type Role = 'arquitecto' | 'ing-estructural' | 'ing-electromecanico' | 'contratista' | 'propietario';

// language-neutral step structure. text (title/inst/note/tip) lives in S.step[key].
interface StepDef {
  key: string;
  online?: boolean;
  nested?: boolean;
  roles: Role[];
  order: Partial<Record<ScnKey, number>>;
  feeKind: 'fixed' | 'tax' | 'assessed' | 'none';
  feeFixed?: number;
}

const steps: StepDef[] = [
  { key: 'eot', roles: ['arquitecto'], order: { urbanizacion: 1 }, feeKind: 'none' },
  { key: 'ante_urb', roles: ['arquitecto'], order: { urbanizacion: 2 }, feeKind: 'none' },
  { key: 'planos_urb', roles: ['arquitecto', 'ing-estructural', 'ing-electromecanico'], order: { urbanizacion: 3 }, feeKind: 'assessed' },
  { key: 'anteproyecto', online: true, roles: ['arquitecto'], order: { vacio: 1, demoler: 1, urbanizacion: 4 }, feeKind: 'fixed', feeFixed: FIXED_FEES.anteproyectoBase },
  { key: 'demolicion', roles: ['contratista'], order: { demoler: 2 }, feeKind: 'assessed' },
  { key: 'terraceria', roles: ['contratista'], order: { vacio: 2, demoler: 3, urbanizacion: 5 }, feeKind: 'none' },
  { key: 'rdp', nested: true, roles: ['arquitecto', 'ing-estructural', 'ing-electromecanico'], order: { vacio: 3, demoler: 4, urbanizacion: 6 }, feeKind: 'fixed', feeFixed: FIXED_FEES.minsaReview + FIXED_FEES.mopReview },
  { key: 'rdpm', nested: true, roles: ['arquitecto', 'ing-estructural', 'ing-electromecanico'], order: { renovar: 1 }, feeKind: 'fixed', feeFixed: FIXED_FEES.minsaReview + FIXED_FEES.mopReview },
  { key: 'pdc', online: true, roles: ['contratista'], order: { vacio: 4, demoler: 5, renovar: 2, urbanizacion: 7 }, feeKind: 'tax' },
  { key: 'traspaso', roles: ['propietario'], order: { urbanizacion: 8 }, feeKind: 'none' },
  { key: 'ocupacion', roles: ['propietario'], order: { vacio: 5, demoler: 6, renovar: 3, urbanizacion: 9 }, feeKind: 'assessed' },
];

const perSheet = FIXED_FEES.perSheet;
type StepText = { title: string; inst: string; note?: string; tip: string };

const STRINGS = {
  es: {
    scn: {
      vacio: { label: 'lote vacío', sub: 'obra nueva' },
      demoler: { label: 'demoler y construir', sub: 'estructura existente' },
      renovar: { label: 'renovar lo existente', sub: 'sin demoler' },
      urbanizacion: { label: 'urbanización', sub: 'más de 10 hectáreas' },
    },
    vu: {
      DOYC: 'dirección de obras y construcciones',
      DINASEPI: 'bomberos · seguridad y prevención de incendios',
      MINSA: 'ministerio de salud',
      MOP: 'ministerio de obras públicas',
      MIVIOT: 'vivienda y ordenamiento territorial',
      IDAAN: 'acueductos y alcantarillados',
      MIAMBIENTE: 'ministerio de ambiente',
      ATTT: 'tránsito y transporte terrestre',
    },
    roles: {
      arquitecto: 'arquitecto',
      'ing-estructural': 'ing. estructural',
      'ing-electromecanico': 'ing. electromecánico',
      contratista: 'contratista',
      propietario: 'propietario',
    } as Record<Role, string>,
    online: '100% en línea',
    vuLabel: 'revisión simultánea · ventanilla única',
    assessed: 'se calcula en inspección',
    startQ: 'quiero construir algo, ¿por dónde empiezo?',
    estK: 'impuesto de construcción estimado',
    estSub: 'sobre un valor de obra de',
    areaLabel: 'área a construir',
    costLabel: 'costo de construcción por m²',
    estNote: 'los montos marcados con * en el mapa dependen del tamaño y del costo por m² que ajustes aquí.',
    calcLink: '¿no sabes cuánto puede costar por m²? usa la calculadora →',
    foot: 'mapa general del proceso, no la lista completa de documentos. las cifras son estimaciones con datos públicos de 2026, para orientar. el impuesto de demolición y el de ocupación los calcula DOYC en inspección, así que aquí se marcan como tales. para el número de tu proyecto, hablemos.',
    notes: {
      renovar: [
        'el anteproyecto (RLA) solo se requiere si la obra cambia el uso, la zonificación o la densidad.',
        'la demolición aplica solo si hay demolición parcial de la estructura.',
      ],
      urbanizacion: [
        'la fase de MIVIOT (EOT, anteproyecto y planos de urbanización) aplica a polígonos de más de 10 hectáreas; más de 300 ha exige además un PPOT por ordenanza municipal.',
      ],
    } as Partial<Record<ScnKey, string[]>>,
    step: {
      eot: { title: 'esquema de ordenamiento territorial (EOT)', inst: 'MIVIOT', note: 'resolución ministerial · MIVIOT', tip: 'el plan maestro para polígonos de más de 10 hectáreas (más de 300 ha exige un PPOT por ordenanza municipal). MIVIOT evalúa uso de suelo, densidad y capacidad ambiental, con revisión de SINAPROC y MIAMBIENTE, y consulta pública si hay alta densidad o vivienda social. termina en una resolución ministerial que habilita la lotificación.' },
      ante_urb: { title: 'anteproyecto de urbanización', inst: 'MIVIOT · ventanilla única', note: 'nota de anteproyecto · validez 2 años', tip: 'la lotificación preliminar, revisada por la ventanilla única de MIVIOT (MIVIOT, MOP, IDAAN, MINSA, MIAMBIENTE y ATTT). da derecho a preventa y a la promesa de compraventa, con validez de 2 años. no autoriza movimiento de tierra ni construcción.' },
      planos_urb: { title: 'planos de urbanización (+ EIA)', inst: 'MIVIOT · ventanilla única', note: 'incluye EIA de MIAMBIENTE', tip: 'los planos de infraestructura ya diseñados: vialidad (MOP y ATTT), drenaje pluvial (MOP), agua potable y sanitario (IDAAN y MINSA), más la resolución de impacto ambiental (EIA) de MIAMBIENTE. al sellarse, MIVIOT emite la nota de apto, que permite segregar las fincas individuales en el registro público.' },
      anteproyecto: { title: 'anteproyecto (RLA)', inst: 'MUPA · DOYC', note: `+ B/. ${perSheet} por lámina`, tip: 'aprobación urbana del concepto: uso de suelo, altura, retiros y densidad. 100% en línea por el portal RLA de alcaldía digital, lo presenta un arquitecto idóneo. no autoriza construir, pero da derecho a preventa. validez 3 años, prorrogable 1 más.' },
      demolicion: { title: 'permiso de demolición', inst: 'DOYC', note: 'impuesto de demolición · MITRADEL si supera B/. 1,000,000', tip: 'requiere un plan de demolición firmado por ingeniero idóneo, con la secuencia de retiro de elementos para evitar el colapso progresivo. DOYC inspecciona el sitio, calcula el impuesto de demolición y emite el permiso en máximo 5 días hábiles tras el pago.' },
      terraceria: { title: 'movimiento de tierra (ATC)', inst: 'DOYC', note: 'autorización transitoria · ATC', tip: 'la autorización transitoria de construcción (ATC) permite arrancar la terracería, el movimiento de tierra y las fundaciones tempranas mientras la ventanilla única termina de revisar los planos. no lleva un impuesto aparte: el de construcción se paga en el PDC.' },
      rdp: { title: 'planos constructivos (RDP)', inst: 'ventanilla única', note: `+ B/. ${perSheet} por lámina + tarifas DINASEPI`, tip: 'revisión técnica multidisciplinaria, en simultáneo, por todas las instituciones de la ventanilla única. requiere un anteproyecto aprobado, e incluye las memorias de cálculo firmadas por los ingenieros estructural y electromecánico. al aprobar, los planos se firman por el director de DOYC y se registran con un número CONS. validez 5 años.' },
      rdpm: { title: 'planos misceláneos (RDPM)', inst: 'ventanilla única', note: `+ B/. ${perSheet} por lámina + tarifas DINASEPI`, tip: 'la vía para obras que no alteran el uso de suelo, la densidad ni la zonificación. exenta del anteproyecto, pero pasa por la misma revisión de la ventanilla única que un RDP, con las memorias de los ingenieros estructural y electromecánico.' },
      pdc: { title: 'permiso de construcción (PDC)', inst: 'DOYC', note: 'impuesto de construcción · acuerdo 73-17', tip: 'autoriza la construcción física, y el permiso queda asignado al contratista. DOYC revisa el presupuesto y fija el avalúo en 10 días hábiles, y emite el permiso 5 días hábiles después del pago. el impuesto de construcción es progresivo sobre el valor de la obra.' },
      traspaso: { title: 'traspaso de infraestructura', inst: 'DOYC · MOP · IDAAN', note: 'actas de aceptación + escritura de traspaso', tip: 'antes de ocupar, el desarrollador entrega al municipio las calles, parques, áreas verdes y servidumbres, con actas de aceptación de MOP e IDAAN y una escritura pública de traspaso (ley 63 de 2015). sin este paso no se emite la ocupación de la urbanización.' },
      ocupacion: { title: 'permiso de ocupación (PDO)', inst: 'DOYC', note: 'impuesto de ocupación', tip: 'la inspección final (PDO, también procesada como SPOC). si no hay objeciones técnicas, DOYC calcula el impuesto de ocupación y, tras el pago, emite el permiso con firma digital y código QR. es el documento que legaliza el uso del edificio.' },
    } as Record<string, StepText>,
  },
  en: {
    scn: {
      vacio: { label: 'empty lot', sub: 'new build' },
      demoler: { label: 'demolish and build', sub: 'existing structure' },
      renovar: { label: 'renovate', sub: 'no demolition' },
      urbanizacion: { label: 'urbanization', sub: 'over 10 hectares' },
    },
    vu: {
      DOYC: 'directorate of works and constructions',
      DINASEPI: 'fire department · safety and fire prevention',
      MINSA: 'ministry of health',
      MOP: 'ministry of public works',
      MIVIOT: 'housing and land management',
      IDAAN: 'aqueducts and sewers',
      MIAMBIENTE: 'ministry of environment',
      ATTT: 'transit and land transport authority',
    },
    roles: {
      arquitecto: 'architect',
      'ing-estructural': 'structural eng.',
      'ing-electromecanico': 'electromechanical eng.',
      contratista: 'contractor',
      propietario: 'owner',
    } as Record<Role, string>,
    online: '100% online',
    vuLabel: 'simultaneous review · single window',
    assessed: 'assessed on inspection',
    startQ: 'i want to build something. where do i start?',
    estK: 'estimated construction tax',
    estSub: 'on a works value of',
    areaLabel: 'area to build',
    costLabel: 'construction cost per m²',
    estNote: 'the amounts marked with * on the map depend on the size and the cost per m² you set here.',
    calcLink: 'not sure what it costs per m²? use the calculator →',
    foot: 'a general map of the process, not the full document list. figures are estimates from public 2026 data, for guidance. the demolition tax and the occupancy tax are assessed by DOYC on inspection, so they are marked as such here. for your project\'s number, let\'s talk.',
    notes: {
      renovar: [
        'the preliminary design (RLA) is only required if the work changes the use, zoning or density.',
        'demolition applies only if there is partial demolition of the structure.',
      ],
      urbanizacion: [
        'the MIVIOT phase (EOT, urbanization preliminary and plans) applies to polygons over 10 hectares; over 300 ha also requires a PPOT by municipal ordinance.',
      ],
    } as Partial<Record<ScnKey, string[]>>,
    step: {
      eot: { title: 'territorial planning scheme (EOT)', inst: 'MIVIOT', note: 'ministerial resolution · MIVIOT', tip: 'the master plan for polygons over 10 hectares (over 300 ha also needs a PPOT by municipal ordinance). MIVIOT evaluates land use, density and environmental capacity, with SINAPROC and MIAMBIENTE review, and a public consultation for high density or social housing. it ends in a ministerial resolution that unlocks the lotification.' },
      ante_urb: { title: 'urbanization preliminary (anteproyecto)', inst: 'MIVIOT · single window', note: 'anteproyecto note · valid 2 years', tip: 'the preliminary lotification, reviewed by MIVIOT\'s single window (MIVIOT, MOP, IDAAN, MINSA, MIAMBIENTE and ATTT). it grants pre-sale and promise-of-sale rights, valid for 2 years. it does not authorize earthworks or construction.' },
      planos_urb: { title: 'urbanization plans (+ EIA)', inst: 'MIVIOT · single window', note: 'includes MIAMBIENTE EIA', tip: 'the infrastructure plans, fully engineered: roads (MOP and ATTT), stormwater (MOP), potable water and sanitary networks (IDAAN and MINSA), plus the environmental impact assessment (EIA) from MIAMBIENTE. once stamped, MIVIOT issues the nota de apto, which lets the individual parcels (fincas) be segregated in the public registry.' },
      anteproyecto: { title: 'preliminary design (RLA)', inst: 'MUPA · DOYC', note: `+ B/. ${perSheet} per sheet`, tip: 'urban approval of the concept: land use, height, setbacks and density. filed 100% online through the RLA portal of alcaldía digital, by a licensed architect. it does not authorize building, but it grants pre-sale rights. valid 3 years, extendable once.' },
      demolicion: { title: 'demolition permit', inst: 'DOYC', note: 'demolition tax · MITRADEL above B/. 1,000,000', tip: 'requires a demolition plan signed by a licensed engineer, with the sequence of element removal to prevent progressive collapse. DOYC inspects the site, assesses the demolition tax and issues the permit within 5 business days of payment.' },
      terraceria: { title: 'earthworks (ATC)', inst: 'DOYC', note: 'transitional authorization · ATC', tip: 'the transitional construction authorization (ATC) lets earthworks, grading and early foundations start while the single window finishes reviewing the plans. it carries no separate tax: the construction tax is paid at the PDC.' },
      rdp: { title: 'construction drawings (RDP)', inst: 'single window', note: `+ B/. ${perSheet} per sheet + DINASEPI fees`, tip: 'the multidisciplinary technical review, all at once, by every institution in the single window. it requires an approved preliminary design, and includes the calculation memories signed by the structural and electromechanical engineers. once approved, the drawings are signed by the DOYC director and registered with a CONS number. valid 5 years.' },
      rdpm: { title: 'miscellaneous plans (RDPM)', inst: 'single window', note: `+ B/. ${perSheet} per sheet + DINASEPI fees`, tip: 'the route for works that do not change land use, density or zoning. exempt from the preliminary design, but it goes through the same single-window review as an RDP, with the structural and electromechanical engineers\' memories.' },
      pdc: { title: 'construction permit (PDC)', inst: 'DOYC', note: 'construction tax · acuerdo 73-17', tip: 'authorizes physical construction, and the permit is assigned to the contractor. DOYC reviews the budget and sets the appraisal in 10 business days, and issues the permit 5 business days after payment. the construction tax is progressive on the value of the works.' },
      traspaso: { title: 'infrastructure handover', inst: 'DOYC · MOP · IDAAN', note: 'acceptance acts + handover deed', tip: 'before occupation, the developer hands the streets, parks, green areas and easements over to the municipality, with acceptance acts from MOP and IDAAN and a public handover deed (ley 63 de 2015). without this step the urbanization\'s occupancy permit is not issued.' },
      ocupacion: { title: 'occupancy permit (PDO)', inst: 'DOYC', note: 'occupancy tax', tip: 'the final inspection (PDO, also processed as SPOC). with no technical objections, DOYC assesses the occupancy tax and, after payment, issues the permit with a digital signature and QR code. it is the document that legalizes the building\'s use.' },
    } as Record<string, StepText>,
  },
}[locale];

// server-render the default (empty lot) sequence numbered, for no-JS + crawlers.
const defaultScn: ScnKey = 'vacio';
const defaultOrder = steps.filter((s) => s.order[defaultScn]).sort((a, b) => a.order[defaultScn]! - b.order[defaultScn]!);
const defaultNum = new Map(defaultOrder.map((s, i) => [s.key, String(i + 1).padStart(2, '0')]));
---

<section class="pmap" data-locale={locale} data-assessed={STRINGS.assessed}>
  <!-- scenario selector -->
  <div class="pmap-start">
    <h2 class="pmap-start-q">{STRINGS.startQ}</h2>
    <div class="seg" role="group" id="pm-scn">
      {scenarioKeys.map((k, i) => (
        <button type="button" class={`seg-btn${i === 0 ? ' active' : ''}`} data-scn={k}>
          <span class="material-symbols-outlined seg-icon">{scenarioIcons[k]}</span>
          <span class="seg-label">{STRINGS.scn[k].label}</span>
          <span class="seg-sub">{STRINGS.scn[k].sub}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- flow -->
  <ol class="pmap-flow" id="pm-flow">
    {steps.map((st) => {
      const t = STRINGS.step[st.key];
      return (
        <li
          class="pstep"
          data-step={st.key}
          data-order-vacio={st.order.vacio ?? ''}
          data-order-demoler={st.order.demoler ?? ''}
          data-order-renovar={st.order.renovar ?? ''}
          data-order-urbanizacion={st.order.urbanizacion ?? ''}
          data-fee-kind={st.feeKind}
          data-fee-fixed={st.feeFixed ?? ''}
          data-fee-note={t.note ?? ''}
          hidden={!st.order[defaultScn]}
          tabindex="0"
        >
          <div class="pstep-card">
            <div class="pstep-head">
              <span class="pstep-num">{defaultNum.get(st.key) ?? ''}</span>
              <div class="pstep-titles">
                <h3 class="pstep-title">{t.title}</h3>
                <div class="pstep-inst">
                  {t.inst}
                  {st.online && <span class="pstep-online">{STRINGS.online}</span>}
                </div>
              </div>
              <span class="pstep-fee" data-fee>—</span>
            </div>
            <div class="pstep-roles">
              {st.roles.map((r) => <span class={`role role-${r}`}>{STRINGS.roles[r]}</span>)}
            </div>
            {st.nested && (
              <div class="pstep-nested">
                <div class="pnest-label">{STRINGS.vuLabel}</div>
                <div class="pnest-chips">
                  {vuKeys.map((v) => (
                    <span class="pnest-chip" tabindex="0">{v}<span class="pnest-tip">{STRINGS.vu[v]}</span></span>
                  ))}
                </div>
              </div>
            )}
            <p class="pstep-tip">{t.tip}</p>
          </div>
        </li>
      );
    })}
  </ol>

  <!-- per-scenario asterisk notes -->
  <div class="pmap-notes">
    {scenarioKeys.map((k) =>
      STRINGS.notes[k]?.length ? (
        <ul data-scn-notes={k} hidden={k !== defaultScn}>
          {STRINGS.notes[k]!.map((n) => <li>{n}</li>)}
        </ul>
      ) : null
    )}
  </div>

  <!-- highlighted cost estimator -->
  <div class="pmap-estimator">
    <div class="est-figure">
      <div class="est-k">{STRINGS.estK} <span class="est-star">*</span></div>
      <div class="est-v" id="pm-tax-head">B/. 2,495</div>
      <div class="est-sub">{STRINGS.estSub} <b id="pm-project-value">B/. 250,000</b></div>
    </div>
    <div class="est-controls">
      <div class="pin-field">
        <label for="pm-area">{STRINGS.areaLabel} <span class="pin-val" id="pm-area-val">250 m²</span></label>
        <input type="range" id="pm-area" min="30" max="10000" step="10" value={DEFAULT_AREA} />
      </div>
      <div class="pin-field">
        <label for="pm-cost">{STRINGS.costLabel} <span class="pin-val" id="pm-cost-val">B/. 1,000</span></label>
        <input type="range" id="pm-cost" min="300" max="4000" step="50" value={DEFAULT_COST_M2} />
      </div>
    </div>
    <p class="est-note">
      <span class="est-star">*</span> {STRINGS.estNote}
      <a class="est-link" href={localized('/tools/cost-calculator', locale)}>{STRINGS.calcLink}</a>
    </p>
  </div>

  <p class="pmap-foot">{STRINGS.foot}</p>
</section>

<style>
  .pmap { padding: 8px 0 24px; }

  /* opt acronyms + B/. currency out of the brand's global lowercase transform */
  .pstep-title, .pstep-tip, .pstep-fee, .pnest-chip, .pnest-tip,
  .pmap-notes li, .est-v, .est-sub, .pin-val, .est-note, .pmap-foot {
    text-transform: none;
  }

  .pmap-start { padding: 8px 0; }
  .pmap-start-q { font-size: clamp(18px, 2vw, 22px); font-weight: 300; letter-spacing: -0.015em; margin: 0 0 18px; }
  .pmap-start .seg { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line-on-paper); }
  @media (max-width: 760px) { .pmap-start .seg { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 460px) { .pmap-start .seg { grid-template-columns: 1fr; } }
  .seg-btn { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; text-align: left; background: none; border: none; border-right: 1px solid var(--line-on-paper); font-family: inherit; padding: 16px 18px; cursor: pointer; color: var(--mute-on-paper); transition: all 0.15s; }
  .seg-btn:last-child { border-right: none; }
  @media (max-width: 760px) {
    .seg-btn { border-right: none; border-bottom: 1px solid var(--line-on-paper); }
    .seg-btn:nth-child(odd) { border-right: 1px solid var(--line-on-paper); }
  }
  @media (max-width: 460px) { .seg-btn { border-right: none !important; } .seg-btn:last-child { border-bottom: none; } }
  .seg-btn:hover { color: var(--ink-on-paper); }
  .seg-btn.active { background: var(--amber); color: #1a1a1a; }
  .seg-icon { font-size: 26px; font-variation-settings: 'wght' 300; margin-bottom: 2px; }
  .seg-label { font-size: 14px; font-weight: 400; letter-spacing: 0.01em; }
  .seg-sub { font-size: 11px; opacity: 0.7; }

  .pmap-flow { list-style: none; padding: 0; margin: 40px 0 0; display: flex; flex-direction: column; }
  .pstep { display: flex; position: relative; padding-bottom: 28px; outline: none; }
  .pstep[hidden] { display: none; }
  .pstep:last-of-type { padding-bottom: 0; }
  .pstep::after { content: ''; position: absolute; left: 27px; top: 100%; width: 1px; height: 28px; background: var(--line-on-paper); transform: translateY(-28px); }
  .pstep:last-of-type::after { display: none; }
  .pstep-card { position: relative; flex: 1; border: 1px solid var(--line-on-paper); background: var(--paper); padding: 20px 24px; transition: border-color 0.15s; }
  .pstep:hover .pstep-card, .pstep:focus .pstep-card, .pstep:focus-within .pstep-card { border-color: var(--ink-on-paper); }
  .pstep-head { display: grid; grid-template-columns: 32px 1fr auto; gap: 16px; align-items: baseline; }
  .pstep-num { font-size: 13px; color: var(--amber); font-weight: 400; font-feature-settings: 'tnum' 1; letter-spacing: 0.06em; }
  .pstep-title { font-size: 17px; font-weight: 400; line-height: 1.2; letter-spacing: -0.01em; margin: 0; }
  .pstep-inst { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; margin-top: 6px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .pstep-online { letter-spacing: 0.06em; color: #1a1a1a; background: var(--amber); padding: 2px 7px; font-weight: 400; }
  .pstep-fee { font-size: 14px; font-weight: 400; text-align: right; white-space: nowrap; font-feature-settings: 'tnum' 1; color: var(--ink-on-paper); }
  .pstep-fee.assessed, .pstep-fee.none { color: var(--mute-on-paper-2); font-size: 12px; font-style: italic; font-weight: 300; }
  .pstep-fee.tax { color: var(--amber); }

  .pstep-roles { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0 48px; }
  .role { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 400; padding: 3px 8px; border: 1px solid var(--line-on-paper); color: var(--mute-on-paper); }
  .role-propietario { border-color: var(--amber); color: var(--ink-on-paper); }

  .pstep-nested { margin: 16px 0 0 48px; padding: 14px 16px; background: var(--paper-2); border: 1px solid var(--line-on-paper-2); }
  .pnest-label { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; margin-bottom: 12px; }
  .pnest-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .pnest-chip { position: relative; font-size: 12px; font-weight: 400; letter-spacing: 0.03em; padding: 5px 10px; background: var(--paper); border: 1px solid var(--line-on-paper); color: var(--ink-on-paper); cursor: help; outline: none; }
  .pnest-chip:hover, .pnest-chip:focus { border-color: var(--amber); }
  .pnest-tip { position: absolute; left: 0; bottom: calc(100% + 6px); z-index: 5; width: max-content; max-width: 240px; background: #1c1c1c; color: #f4f1ea; font-size: 11px; font-weight: 300; letter-spacing: 0; line-height: 1.4; padding: 8px 10px; opacity: 0; visibility: hidden; transition: opacity 0.12s; pointer-events: none; }
  .pnest-chip:hover .pnest-tip, .pnest-chip:focus .pnest-tip { opacity: 1; visibility: visible; }

  .pstep-tip { margin: 14px 0 0 48px; font-size: 13px; line-height: 1.55; color: var(--mute-on-paper); font-weight: 300; max-width: 68ch; max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.25s ease, opacity 0.2s; }
  .pstep:hover .pstep-tip, .pstep:focus .pstep-tip, .pstep:focus-within .pstep-tip, .pstep.open .pstep-tip { max-height: 260px; opacity: 1; }
  @media (max-width: 640px) {
    .pstep-head { grid-template-columns: 28px 1fr; }
    .pstep-fee { grid-column: 2; text-align: left; margin-top: 6px; }
    .pstep-roles, .pstep-nested, .pstep-tip { margin-left: 0; }
  }

  .pmap-notes { margin-top: 28px; }
  .pmap-notes ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .pmap-notes li { font-size: 12px; line-height: 1.5; color: var(--mute-on-paper); font-weight: 300; padding-left: 16px; position: relative; }
  .pmap-notes li::before { content: '*'; position: absolute; left: 0; color: var(--amber); }

  .pmap-estimator { margin-top: 40px; border: 1px solid var(--ink-on-paper); background: var(--paper-2); padding: 28px 28px 24px; display: grid; grid-template-columns: auto 1fr; gap: 32px 48px; align-items: start; }
  @media (max-width: 700px) { .pmap-estimator { grid-template-columns: 1fr; gap: 24px; } }
  .est-figure { border-left: 3px solid var(--amber); padding-left: 18px; }
  .est-k { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute-on-paper); font-weight: 400; }
  .est-star { color: var(--amber); }
  .est-v { font-size: clamp(30px, 3.6vw, 42px); font-weight: 300; letter-spacing: -0.03em; color: var(--amber); font-feature-settings: 'tnum' 1; line-height: 1.05; margin: 6px 0 4px; min-width: 13ch; white-space: nowrap; }
  .est-sub { font-size: 12px; color: var(--mute-on-paper); font-weight: 300; }
  .est-sub b { color: var(--ink-on-paper); font-weight: 400; }
  .est-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 28px; }
  @media (max-width: 520px) { .est-controls { grid-template-columns: 1fr; } }
  .pin-field label { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute-on-paper); font-weight: 400; margin-bottom: 10px; }
  .pin-val { color: var(--ink-on-paper); font-size: 13px; letter-spacing: 0; text-transform: none; font-feature-settings: 'tnum' 1; }
  .pin-field input[type='range'] { width: 100%; accent-color: var(--amber); cursor: pointer; }
  .est-note { grid-column: 1 / -1; font-size: 12px; line-height: 1.55; color: var(--mute-on-paper); font-weight: 300; margin: 4px 0 0; }
  .est-link { display: inline-block; margin-top: 6px; color: var(--ink-on-paper); border-bottom: 1px solid var(--line-on-paper-2); }
  .est-link:hover { color: var(--amber); border-bottom-color: var(--amber); }

  .pmap-foot { margin-top: 28px; font-size: 12px; line-height: 1.6; color: var(--mute-on-paper-2); font-weight: 300; font-style: italic; max-width: 72ch; }
</style>

<script>
  import { constructionTax } from '../lib/permitFees';

  const root = document.querySelector('.pmap') as HTMLElement | null;
  if (root) {
    const locale = root.dataset.locale === 'en' ? 'en' : 'es';
    const assessedText = root.dataset.assessed ?? 'se calcula en inspección';
    const money = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-PA', { maximumFractionDigits: 0 });
    const b = (n: number) => `B/. ${money.format(Math.round(n))}`;
    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

    const areaEl = document.getElementById('pm-area') as HTMLInputElement;
    const costEl = document.getElementById('pm-cost') as HTMLInputElement;
    const areaVal = document.getElementById('pm-area-val')!;
    const costVal = document.getElementById('pm-cost-val')!;
    const valueEl = document.getElementById('pm-project-value')!;
    const taxHead = document.getElementById('pm-tax-head')!;
    const flow = document.getElementById('pm-flow') as HTMLElement;
    const stepEls = Array.from(flow.querySelectorAll<HTMLElement>('.pstep'));
    const scnBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('#pm-scn .seg-btn'));
    const noteLists = Array.from(root.querySelectorAll<HTMLElement>('[data-scn-notes]'));

    let scenario: 'vacio' | 'demoler' | 'renovar' | 'urbanizacion' = 'vacio';

    function fees() {
      const area = Number(areaEl.value);
      const cost = Number(costEl.value);
      const value = area * cost;
      const tax = constructionTax(value);
      const atMax = area >= Number(areaEl.max) && cost >= Number(costEl.max);
      const pre = atMax ? '> ' : '';

      areaVal.textContent = `${money.format(area)} m²`;
      costVal.textContent = b(cost);
      valueEl.textContent = `${pre}${b(value)}`;
      taxHead.textContent = `${pre}${b(tax)}`;

      for (const li of stepEls) {
        const feeEl = li.querySelector('[data-fee]') as HTMLElement;
        const kind = li.dataset.feeKind ?? 'fixed';
        const note = li.dataset.feeNote ?? '';
        feeEl.classList.remove('assessed', 'tax', 'none');
        if (kind === 'tax') {
          feeEl.classList.add('tax');
          feeEl.textContent = `≈ ${pre}${b(tax)} *`;
        } else if (kind === 'assessed') {
          feeEl.classList.add('assessed');
          feeEl.textContent = assessedText;
        } else if (kind === 'none') {
          feeEl.classList.add('none');
          feeEl.textContent = note;
        } else {
          const fixed = Number(li.dataset.feeFixed || 0);
          feeEl.textContent = note ? `${b(fixed)} ${note}` : b(fixed);
        }
      }
    }

    function applyScenario() {
      const visible: HTMLElement[] = [];
      for (const li of stepEls) {
        const ord = li.dataset[`order${cap(scenario)}` as keyof DOMStringMap];
        if (ord) {
          li.hidden = false;
          li.style.order = String(ord);
          visible.push(li);
        } else {
          li.hidden = true;
        }
      }
      visible.sort((a, b2) => Number(a.style.order) - Number(b2.style.order));
      visible.forEach((li, i) => {
        (li.querySelector('.pstep-num') as HTMLElement).textContent = String(i + 1).padStart(2, '0');
      });
      for (const ul of noteLists) ul.hidden = ul.dataset.scnNotes !== scenario;
    }

    scnBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        scnBtns.forEach((x) => x.classList.remove('active'));
        btn.classList.add('active');
        scenario = btn.dataset.scn as typeof scenario;
        applyScenario();
      });
    });

    [areaEl, costEl].forEach((el) => el.addEventListener('input', fees));

    stepEls.forEach((li) => {
      li.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a, .pnest-chip')) return;
        li.classList.toggle('open');
      });
    });

    applyScenario();
    fees();
  }
</script>
