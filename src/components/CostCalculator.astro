          <div class="assum-row"><span class="ak">{S.aWater}</span><span class="av">{c(PERCAPITA[k])}<span class="au">{S.aWaterUnit}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aOcc}</span><span class="av">{DENSITY[k]}<span class="au">{S.aOccUnit}{k === 'residential-sf' ? ` · ${S.aOccCap}` : ''}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aMaint}</span><span class="av">{money2(MAINT_M2[k].standard)}<span class="au">{S.aMaintUnit}</span></span></div>
        </div>
      ))}
    </div>
  </div>

  <!-- ============ sources ============ -->
  <div class="calc-sources">
    <div class="eyebrow">{S.sourcesEb}</div>
    <h2 class="assum-h">{S.sourcesH}</h2>
    <div class="src-grid">
