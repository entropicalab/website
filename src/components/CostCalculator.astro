---
// interactive panama building cost estimator.
// one component, locale-driven. the client island lives at the bottom and
// imports the pure model from src/lib/costModel.ts.
import type { Locale } from '../i18n/strings';
import {
  CAPEX_M2,
  EUI,
  DENSITY,
  PERCAPITA,
  MAINT_M2,
  type Typology,
  type Range,
} from '../lib/costModel';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// formspree endpoint (same as the contact form) — used for lead capture
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xkoerobb';

// server-side range formatters for the assumptions table
const rng = (x: Range, dp = 0): string => {
  const f = (n: number) => n.toFixed(dp);
  return x.low === x.high ? f(x.low) : `${f(x.low)}–${f(x.high)}`;
};
const money = (x: Range): string => `$${rng(x)}`;
const money2 = (x: Range): string => `$${rng(x, 2)}`;

const S = {
  es: {
    areaLabel: 'área construida',
    typLabel: 'categoría de edificio',
    typ: {
      'residential-sf': 'residencial · unifamiliar',
      'residential-mf': 'residencial · multifamiliar',
      office: 'oficinas',
