        <div class="src-group">
          <div class="src-group-name">{s.group}</div>
          <ul>
            {s.items.map((it) => (<li><a href={it.url} target="_blank" rel="noopener nofollow">{it.name}</a></li>))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

