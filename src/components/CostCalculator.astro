---

<section
  class="calc"
  data-locale={locale}
  data-maint-ph={S.maintenancePH}
  data-maint-home={S.maintenanceHome}
  data-capex-eb={S.capexEb}
  data-capex-eb-reno={S.capexEbReno}
  data-capex-h={S.capexH}
  data-capex-h-reno={S.capexHReno}
  data-capex-k={S.construction}
  data-capex-k-reno={S.constructionReno}
  data-lc-label-dev={S.lcSavingsLabel}
  data-lc-label-home={S.lcSavingsLabelHome}
>
  <div class="calc-grid">
    <!-- ============ inputs ============ -->
    <div class="calc-inputs">
      <div class="eyebrow">{S.inputsEb}</div>
      <h2 class="calc-h">{S.inputsH}</h2>

      <div class="field">
        <label>{S.modeLabel}</label>
        <div class="seg" role="group" id="ci-mode">
          <button type="button" class="seg-btn active" data-mode="new">{S.modeNew}</button>
          <button type="button" class="seg-btn" data-mode="renovation">{S.modeReno}</button>
        </div>
      </div>

      <div class="field">
        <label>{S.audienceLabel}</label>
        <div class="seg" role="group" id="ci-aud">
          <button type="button" class="seg-btn active" data-aud="dev">{S.audDev}</button>
          <button type="button" class="seg-btn" data-aud="home">{S.audHome}</button>
        </div>
      </div>

      <div class="field">
        <label for="ci-area">{S.areaLabel} <span class="val" id="ci-area-val">250 m²</span></label>
        <input type="range" id="ci-area" min="50" max="10000" step="10" value="250" />
      </div>

      <div class="field">
        <label for="ci-typ">{S.typLabel}</label>
        <select id="ci-typ">
          {typOrder.map((k) => <option value={k}>{S.typ[k]}</option>)}
        </select>
      </div>

      <div class="field">
        <label>{S.tierLabel}</label>
        <div class="seg" role="group" id="ci-tier">
          <button type="button" class="seg-btn" data-tier="basic">{S.tier.basic}</button>
          <button type="button" class="seg-btn active" data-tier="standard">{S.tier.standard}</button>
          <button type="button" class="seg-btn" data-tier="premium">{S.tier.premium}</button>
        </div>
      </div>

      <div class="field">
        <label for="ci-ac">{S.acLabel} <span class="val" id="ci-ac-val">80 %</span></label>
        <input type="range" id="ci-ac" min="0" max="100" step="5" value="80" />
      </div>

      <div class="checks">
        <label class="check" id="ci-watercool-label">
          <input type="checkbox" id="ci-watercool" />
          <span>{S.waterCooled} <span class="check-hint">· {S.waterCooledHint}</span></span>
        </label>
      </div>
    </div>

    <!-- ============ results ============ -->
    <div class="calc-results">
      <!-- capex -->
      <div class="res-block">
        <div class="eyebrow" id="r-capex-eb">{S.capexEb}</div>
        <h3 class="res-h" id="r-capex-h">{S.capexH}</h3>
        <div class="res-row">
          <span class="rk" id="r-capex-klabel">{S.construction}</span>
          <span class="rv" id="r-capex-hard">—</span>
        </div>
        <div class="res-row strong">
          <span class="rk">{S.totalDev}</span>
          <span class="rv" id="r-capex-total">—</span>
        </div>
        <p class="res-note"><span id="r-capex-m2">—</span> · {S.perM2}</p>
        <p class="res-note">{S.softNote}</p>
        <p class="res-note">{S.excludesNote}</p>
      </div>

      <!-- energy, two scenarios — comparison bars lead, numbers on demand -->
      <div class="res-block">
        <div class="eyebrow">{S.energyEb}</div>
        <h3 class="res-h">{S.energyH}</h3>
        <p class="res-gloss">{S.resGloss}</p>

        <div class="bars">
          <div class="bar-row">
            <div class="bar-label">{S.scenRegular}<span class="bar-total" id="r-en-reg-total">—</span></div>
            <div class="bar">
              {useOrder.map((u) => <span class={`bseg seg-${u}`} id={`bar-reg-${u}`}></span>)}
            </div>
          </div>
          <div class="bar-row">
            <div class="bar-label alt">{S.scenSustainable}<span class="bar-total" id="r-en-sus-total">—</span></div>
            <div class="bar">
              {useOrder.map((u) => <span class={`bseg seg-${u}`} id={`bar-sus-${u}`}></span>)}
            </div>
          </div>
        </div>

        <div class="bar-legend">
          {useOrder.map((u) => (
            <span class="lg"><i class={`sw seg-${u}`}></i>{S.use[u]}</span>
          ))}
        </div>

        <p class="bar-note">{S.savingsLabel} <b id="r-savings">—</b></p>

        <details class="num-details">
          <summary>{S.energyBreakdown}</summary>
          <div class="scen-grid">
            <div class="scen">
              <div class="scen-name">{S.scenRegular}</div>
              {useOrder.map((u) => (
                <div class="res-row sm"><span class="rk">{S.use[u]}</span><span class="rv" id={`r-en-reg-${u}`}>—</span></div>
              ))}
            </div>
            <div class="scen scen-alt">
              <div class="scen-name">{S.scenSustainable}</div>
              {useOrder.map((u) => (
                <div class="res-row sm"><span class="rk">{S.use[u]}</span><span class="rv" id={`r-en-sus-${u}`}>—</span></div>
              ))}
            </div>
          </div>
        </details>
      </div>

      <!-- monthly opex roll-up, two scenarios -->
      <div class="res-block">
        <div class="eyebrow">{S.opexEb}</div>
        <h3 class="res-h">{S.opexH}</h3>
        <div class="scen-grid">
          <div class="scen">
            <div class="scen-name">{S.scenRegular}</div>
            <div class="res-row sm"><span class="rk">{S.energyLine}</span><span class="rv" id="r-opex-reg-energy">—</span></div>
            <div class="res-row sm"><span class="rk">{S.water}</span><span class="rv" id="r-opex-reg-water">—</span></div>
            <div class="res-row sm"><span class="rk js-maint-label">{S.maintenancePH}</span><span class="rv" id="r-opex-reg-maint">—</span></div>
            <div class="res-row sm strong"><span class="rk">{S.total}</span><span class="rv" id="r-opex-reg-total">—</span></div>
          </div>
          <div class="scen scen-alt">
            <div class="scen-name">{S.scenSustainable}</div>
            <div class="res-row sm"><span class="rk">{S.energyLine}</span><span class="rv" id="r-opex-sus-energy">—</span></div>
            <div class="res-row sm"><span class="rk">{S.water}</span><span class="rv" id="r-opex-sus-water">—</span></div>
            <div class="res-row sm"><span class="rk js-maint-label">{S.maintenancePH}</span><span class="rv" id="r-opex-sus-maint">—</span></div>
            <div class="res-row sm strong"><span class="rk">{S.total}</span><span class="rv" id="r-opex-sus-total">—</span></div>
          </div>
        </div>
      </div>

      <!-- lifecycle: 30-year total cost of ownership — THE headline -->
      <div class="res-block lc-block">
        <div class="eyebrow">{S.lcEb}</div>
        <h3 class="res-h">{S.lcH}</h3>

        <div class="bars">
          <div class="bar-row">
            <div class="bar-label">{S.lcRegular}<span class="bar-total" id="r-lc-reg">—</span></div>
            <div class="bar"><span class="bseg seg-typ" id="bar-lc-reg"></span></div>
          </div>
          <div class="bar-row">
            <div class="bar-label alt">{S.lcSustainable}<span class="bar-total" id="r-lc-sus">—</span></div>
            <div class="bar"><span class="bseg seg-sus" id="bar-lc-sus"></span></div>
          </div>
        </div>

        <div class="lc-hero">
          <div class="lc-hero-num" id="r-lc-savings">—</div>
          <p class="lc-hero-label" id="r-lc-savings-label">{S.lcSavingsLabel}</p>
        </div>
      </div>

      <!-- lead capture -->
      <div class="res-block email-block" id="email-block">
        <div class="eyebrow">{S.emailEb}</div>
        <h3 class="res-h">{S.emailH}</h3>
        <form class="email-form" action={FORMSPREE_ENDPOINT} method="POST">
          <input type="email" name="email" required placeholder={S.emailPlaceholder} autocomplete="email" />
          <button type="submit" class="btn amber">{S.emailBtn}</button>
          <input type="hidden" name="_subject" value="entropica-lab.com · calculadora · nuevo lead" />
          <input type="hidden" name="origen" value="cost-calculator" />
          <input type="hidden" name="resumen" id="email-summary" value="" />
          <div class="honeypot" aria-hidden="true"><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
        </form>
        <p class="res-note">{S.emailNote}</p>
      </div>
      <div class="res-block email-sent" id="email-sent" hidden>
        <div class="eyebrow amber">{S.emailEb}</div>
        <h3 class="res-h">{S.emailSentH}</h3>
        <p class="res-note">{S.emailSentBody}</p>
      </div>

      <details class="methodology">
        <summary>{S.methodology}</summary>
        <p class="disclaimer">{S.disclaimer}</p>
        <p class="disclaimer">{S.lcNote}</p>
      </details>
    </div>
  </div>

  <!-- ============ assumptions: per-category averages ============ -->
  <div class="calc-assumptions">
    <div class="eyebrow">{S.assumptionsEb}</div>
    <h2 class="assum-h">{S.assumptionsH}</h2>
    <p class="assum-intro">{S.assumptionsIntro}</p>
    <div class="assum-grid">
      {typOrder.map((k) => (
        <div class="assum-card">
          <div class="assum-title">{S.typ[k]}</div>
          <div class="assum-row"><span class="ak">{S.aCapex}</span><span class="av">{money(CAPEX_M2[k].standard)}<span class="au">/m²</span></span></div>
          <div class="assum-row"><span class="ak">{S.aEnergy}</span><span class="av">{rng(EUI[k].fc)}<span class="au">{S.aEnergyUnit}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aWater}</span><span class="av">{rng(PERCAPITA[k])}<span class="au">{S.aWaterUnit}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aOcc}</span><span class="av">{DENSITY[k]}<span class="au">{S.aOccUnit}{k === 'residential-sf' ? ` · ${S.aOccCap}` : ''}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aMaint}</span><span class="av">{money2(MAINT_M2[k].standard)}<span class="au">{S.aMaintUnit}</span></span></div>
        </div>
      ))}
    </div>
  </div>

  <!-- ============ sources ============ -->
  <div class="calc-sources">
    <div class="eyebrow">{S.sourcesEb}</div>
    <h2 class="assum-h">{S.sourcesH}</h2>
    <div class="src-grid">
      {sources.map((s) => (
        <div class="src-group">
          <div class="src-group-name">{s.group}</div>
          <ul>
            {s.items.map((it) => (
              <li><a href={it.url} target="_blank" rel="noopener nofollow">{it.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .calc { padding: 8px 0 24px; }
  .calc-grid { display: grid; grid-template-columns: 360px 1fr; gap: 56px; align-items: start; }
  @media (max-width: 900px) { .calc-grid { grid-template-columns: 1fr; gap: 40px; } }

  .calc-inputs { position: sticky; top: 24px; }
  @media (max-width: 900px) { .calc-inputs { position: static; } }
  .calc-inputs .eyebrow,
  .res-block .eyebrow,
  .proof-copy .eyebrow,
  .calc-assumptions .eyebrow,
  .calc-sources .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 400; margin-bottom: 12px; display: inline-block; }
  .calc-h { font-size: 22px; font-weight: 300; letter-spacing: -0.015em; margin: 0 0 28px; }

  .field { margin-bottom: 24px; }
  .field label { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute-on-paper); font-weight: 400; margin-bottom: 10px; }
  .field label .val { color: var(--ink-on-paper); font-size: 13px; letter-spacing: 0; text-transform: none; }
  input[type='range'] { width: 100%; accent-color: var(--amber); cursor: pointer; }
  select { width: 100%; font-family: inherit; font-size: 14px; font-weight: 300; padding: 10px 12px; background: var(--paper); border: 1px solid var(--line-on-paper); color: var(--ink-on-paper); border-radius: 0; cursor: pointer; }
  select:focus { outline: 1px solid var(--amber); }

  .seg { display: flex; border: 1px solid var(--line-on-paper); }
  .seg-btn { flex: 1; background: none; border: none; border-right: 1px solid var(--line-on-paper); font-family: inherit; font-size: 12px; letter-spacing: 0.04em; padding: 10px 4px; cursor: pointer; color: var(--mute-on-paper); transition: all 0.15s; }
  .seg-btn:last-child { border-right: none; }
  .seg-btn:hover { color: var(--ink-on-paper); }
  .seg-btn.active { background: var(--amber); color: #1a1a1a; }

  .checks { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .check { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; font-weight: 300; color: var(--ink-on-paper); cursor: pointer; line-height: 1.4; }
  .check input { accent-color: var(--amber); width: 16px; height: 16px; cursor: pointer; margin-top: 2px; flex: none; }
  .check-hint { color: var(--mute-on-paper-2); font-size: 11px; }
  .check.disabled { opacity: 0.45; cursor: not-allowed; }
  .check.disabled input { cursor: not-allowed; }

  .calc-results { display: flex; flex-direction: column; gap: 28px; }
  .res-block { border: 1px solid var(--line-on-paper); padding: 28px; }
  .res-h { font-size: 18px; font-weight: 300; letter-spacing: -0.01em; margin: 0 0 20px; }
  .res-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 9px 0; border-top: 1px solid var(--line-on-paper-2); }
  .res-row:first-of-type { border-top: none; }
  .res-row.sm { padding: 6px 0; }
  .res-row .rk { font-size: 13px; color: var(--mute-on-paper); font-weight: 300; }
  .res-row .rv { font-size: 14px; font-weight: 400; font-feature-settings: 'tnum' 1; text-align: right; white-space: nowrap; }
  .res-row.strong .rk { color: var(--ink-on-paper); }
  .res-row.strong .rv { font-size: 15px; }
  .res-note { font-size: 12px; color: var(--mute-on-paper); font-weight: 300; margin: 12px 0 0; line-height: 1.55; }

  .scen-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 540px) { .scen-grid { grid-template-columns: 1fr; gap: 28px; } }
  .scen-name { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--line-on-paper); }
  .scen-alt .scen-name { color: var(--ink-on-paper); }

  /* gloss line under a section header */
  .res-gloss { font-size: 12px; line-height: 1.5; color: var(--mute-on-paper); font-weight: 300; font-style: italic; margin: -8px 0 22px; max-width: 60ch; }

  /* comparison bars */
  .bars { display: flex; flex-direction: column; gap: 16px; }
  .bar-row { display: flex; flex-direction: column; gap: 7px; }
  .bar-label { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; }
  .bar-label.alt { color: var(--ink-on-paper); }
  .bar-total { font-size: 14px; letter-spacing: 0; text-transform: none; font-weight: 400; color: var(--ink-on-paper); font-feature-settings: 'tnum' 1; }
  .bar { display: flex; height: 26px; background: var(--paper-2); border: 1px solid var(--line-on-paper); overflow: hidden; }
  .bseg { height: 100%; display: block; width: 0; transition: width 0.35s ease; }
  /* brandbook palette: clay-red = cooling/hot-side, tobacco = lighting,
     swell-blue = plug loads, mangrove-green = passive/sustainable */
  .seg-ac { background: var(--barro); }
  .seg-lighting { background: var(--tabaco); }
  .seg-plug { background: var(--marejada); }
  .seg-other { background: var(--manglar); }
  .seg-typ { background: var(--barro); }
  .seg-sus { background: var(--manglar); }

  .bar-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 16px; }
  .bar-legend .lg { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; color: var(--mute-on-paper); font-weight: 300; }
  .bar-legend .sw { width: 11px; height: 11px; display: inline-block; flex: none; }

  .bar-note { font-size: 13px; color: var(--mute-on-paper); font-weight: 300; margin: 18px 0 0; line-height: 1.5; }
  .bar-note b { color: var(--ink-on-paper); font-weight: 400; }

  .num-details { margin-top: 16px; border-top: 1px solid var(--line-on-paper-2); padding-top: 8px; }
  .num-details summary { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; cursor: pointer; padding: 6px 0; list-style: none; }
  .num-details summary::-webkit-details-marker { display: none; }
  .num-details summary::before { content: '+ '; }
  .num-details[open] summary::before { content: '– '; }
  .num-details[open] summary { margin-bottom: 12px; }

  /* lifecycle = the headline block */
  .lc-block { border-color: var(--ink-on-paper); }
  .lc-hero { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line-on-paper); }
  .lc-hero-num { font-size: clamp(52px, 10vw, 104px); color: var(--amber); letter-spacing: -0.04em; line-height: 0.92; font-weight: 300; font-feature-settings: 'tnum' 1, 'lnum' 1; white-space: nowrap; }
  .lc-hero-label { font-size: 15px; line-height: 1.5; color: var(--ink-on-paper); font-weight: 300; margin: 10px 0 0; max-width: 36ch; }

  /* lead capture */
  .email-block .res-h { margin-bottom: 16px; }
  .email-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .email-form input[type='email'] { flex: 1; min-width: 200px; font-family: inherit; font-size: 14px; font-weight: 300; padding: 11px 14px; background: var(--paper); border: 1px solid var(--line-on-paper); color: var(--ink-on-paper); }
  .email-form input[type='email']:focus { outline: 1px solid var(--amber); }
  .email-form .btn { white-space: nowrap; }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* collapsible methodology */
  .methodology { border: 1px solid var(--line-on-paper); padding: 4px 24px; }
  .methodology summary { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; cursor: pointer; padding: 14px 0; list-style: none; }
  .methodology summary::-webkit-details-marker { display: none; }
  .methodology summary::before { content: '+ '; }
  .methodology[open] summary::before { content: '– '; }
  .disclaimer { font-size: 13px; line-height: 1.7; color: var(--mute-on-paper); font-weight: 300; margin: 0 0 14px; max-width: 72ch; }
  .methodology[open] summary { margin-bottom: 8px; }

  /* assumptions */
  .calc-assumptions { padding: 64px 0 8px; border-top: 1px solid var(--line-on-paper); margin-top: 48px; }
  .assum-h { font-size: clamp(22px, 2.6vw, 30px); font-weight: 300; letter-spacing: -0.015em; margin: 0 0 16px; }
  .assum-intro { font-size: 14px; line-height: 1.65; color: var(--mute-on-paper); font-weight: 300; max-width: 70ch; margin: 0 0 36px; }
  .assum-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 900px) { .assum-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .assum-grid { grid-template-columns: 1fr; } }
  .assum-card { border: 1px solid var(--line-on-paper); padding: 22px; }
  .assum-title { font-size: 14px; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line-on-paper); }
  .assum-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 7px 0; }
  .assum-row .ak { font-size: 12px; color: var(--mute-on-paper); font-weight: 300; }
  .assum-row .av { font-size: 13px; font-weight: 400; text-align: right; font-feature-settings: 'tnum' 1; white-space: nowrap; }
  .assum-row .au { font-size: 10px; color: var(--mute-on-paper-2); margin-left: 4px; }

  /* sources */
  .calc-sources { padding: 56px 0 8px; border-top: 1px solid var(--line-on-paper); margin-top: 48px; }
  .src-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 48px; }
  @media (max-width: 700px) { .src-grid { grid-template-columns: 1fr; } }
  .src-group-name { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; margin-bottom: 12px; }
  .src-group ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .src-group li { font-size: 13px; line-height: 1.45; font-weight: 300; }
  .src-group a { color: var(--ink-on-paper); border-bottom: 1px solid var(--line-on-paper-2); }
  .src-group a:hover { color: var(--amber); border-bottom-color: var(--amber); }
</style>

<script>
  import { estimateAll, type CalculatorInputs, type Tier, type Typology, type Mode, type Range } from '../lib/costModel';

  const root = document.querySelector('.calc') as HTMLElement;
  if (root) {
    const d = root.dataset;
    const locale = (document.documentElement.lang === 'en' ? 'en' : 'es') as 'en' | 'es';
    const money = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-PA', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    });
    const num = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-PA', { maximumFractionDigits: 0 });

    const fmtRange = (x: Range): string => {
      const lo = Math.round(x.low);
      const hi = Math.round(x.high);
      if (lo === hi) return money.format(lo);
      return `${money.format(lo)} – ${money.format(hi)}`;
    };

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const areaEl = $('ci-area') as HTMLInputElement;
    const acEl = $('ci-ac') as HTMLInputElement;
    const typEl = $('ci-typ') as HTMLSelectElement;
    const waterEl = $('ci-watercool') as HTMLInputElement;
    const waterLabel = $('ci-watercool-label') as HTMLElement;
    const tierBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-tier .seg-btn'));
    const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-mode .seg-btn'));
    const audBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-aud .seg-btn'));
    const maintLabels = Array.from(document.querySelectorAll<HTMLElement>('.js-maint-label'));
    const maintPH = d.maintPh ?? 'maintenance (ph)';
    const maintHome = d.maintHome ?? 'upkeep';
    let tier: Tier = 'standard';
    let mode: Mode = 'new';
    let audience: 'dev' | 'home' = 'dev';

    // water-cooled AC only applies to non-residential cooling towers
    function syncWaterCool() {
      const isRes = typEl.value.startsWith('residential');
      waterEl.disabled = isRes;
      waterLabel.classList.toggle('disabled', isRes);
      if (isRes) waterEl.checked = false;
    }

    // a standalone single-family home is not a PH (horizontal property);
    // its recurring cost is private upkeep, so the label switches.
    function syncMaintLabel() {
      const label = typEl.value === 'residential-sf' ? maintHome : maintPH;
      maintLabels.forEach((el) => (el.textContent = label));
    }

    function render() {
      const input: CalculatorInputs = {
        area: Number(areaEl.value),
        typology: typEl.value as Typology,
        tier,
        pctAC: Number(acEl.value) / 100,
        waterCooledAC: waterEl.checked,
        mode,
      };

      $('ci-area-val').textContent = `${num.format(input.area)} m²`;
      $('ci-ac-val').textContent = `${acEl.value} %`;

      const e = estimateAll(input);

      // capex — labels adapt to new build vs renovation
      const reno = mode === 'renovation';
      $('r-capex-eb').textContent = (reno ? d.capexEbReno : d.capexEb) ?? '';
      $('r-capex-h').textContent = (reno ? d.capexHReno : d.capexH) ?? '';
      $('r-capex-klabel').textContent = (reno ? d.capexKReno : d.capexK) ?? '';
      $('r-capex-hard').textContent = fmtRange(e.capex.hard);
      $('r-capex-total').textContent = fmtRange(e.capex.total);
      $('r-capex-m2').textContent = fmtRange(e.capex.perM2);

      // energy per use
      (['ac', 'lighting', 'plug', 'other'] as const).forEach((u) => {
        $(`r-en-reg-${u}`).textContent = fmtRange(e.energy.regular.perUse[u]);
        $(`r-en-sus-${u}`).textContent = fmtRange(e.energy.sustainable.perUse[u]);
      });
      $('r-en-reg-total').textContent = fmtRange(e.energy.regular.total);
      $('r-en-sus-total').textContent = fmtRange(e.energy.sustainable.total);

      // proof: annual savings (midpoint headline)
      const savMid = Math.round((e.energy.annualSavings.low + e.energy.annualSavings.high) / 2);
      $('r-savings').textContent = money.format(Math.max(savMid, 0));

      // opex, two scenarios (water + maintenance identical both sides)
      $('r-opex-reg-energy').textContent = fmtRange(e.energy.regular.total);
      $('r-opex-sus-energy').textContent = fmtRange(e.energy.sustainable.total);
      $('r-opex-reg-water').textContent = fmtRange(e.water.monthly);
      $('r-opex-sus-water').textContent = fmtRange(e.water.monthly);
      $('r-opex-reg-maint').textContent = fmtRange(e.maintenance.monthly);
      $('r-opex-sus-maint').textContent = fmtRange(e.maintenance.monthly);
      $('r-opex-reg-total').textContent = fmtRange(e.monthlyOpex.regular);
      $('r-opex-sus-total').textContent = fmtRange(e.monthlyOpex.sustainable);

      // lifecycle: 30-year total cost of ownership
      $('r-lc-reg').textContent = fmtRange(e.lifecycle.regular);
      $('r-lc-sus').textContent = fmtRange(e.lifecycle.sustainable);

      // hero number adapts to audience: developer → 30-yr discounted saving;
      // homeowner → monthly saving on the bill.
      if (audience === 'home') {
        const mSav = Math.round((e.energy.monthlySavings.low + e.energy.monthlySavings.high) / 2);
        $('r-lc-savings').textContent = money.format(Math.max(mSav, 0));
        $('r-lc-savings-label').textContent = d.lcLabelHome ?? '';
      } else {
        const lcSav = Math.round((e.lifecycle.savings.low + e.lifecycle.savings.high) / 2);
        $('r-lc-savings').textContent = money.format(Math.max(lcSav, 0));
        $('r-lc-savings-label').textContent = d.lcLabelDev ?? '';
      }

      // lead-capture summary (hidden field sent with the email)
      const summary = $('email-summary') as HTMLInputElement | null;
      if (summary) {
        summary.value = `${mode} · ${input.typology} · ${input.area} m² · ${tier} · a/c ${acEl.value}% · capex ${fmtRange(e.capex.total)} · opex ${fmtRange(e.monthlyOpex.regular)}→${fmtRange(e.monthlyOpex.sustainable)}/mes`;
      }

      // comparison bars — widths as % of a shared scale (the larger total)
      const mid = (x: Range) => (x.low + x.high) / 2;
      const setW = (id: string, pct: number) => {
        const el = document.getElementById(id);
        if (el) el.style.width = `${Math.max(0, Math.min(100, pct))}%`;
      };
      const enMax = mid(e.energy.regular.total) || 1;
      (['ac', 'lighting', 'plug', 'other'] as const).forEach((u) => {
        setW(`bar-reg-${u}`, (mid(e.energy.regular.perUse[u]) / enMax) * 100);
        setW(`bar-sus-${u}`, (mid(e.energy.sustainable.perUse[u]) / enMax) * 100);
      });
      const lcMax = mid(e.lifecycle.regular) || 1;
      setW('bar-lc-reg', (mid(e.lifecycle.regular) / lcMax) * 100);
      setW('bar-lc-sus', (mid(e.lifecycle.sustainable) / lcMax) * 100);
    }

    const wireSeg = (
      btns: HTMLButtonElement[],
      onPick: (btn: HTMLButtonElement) => void
    ) => {
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          btns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          onPick(btn);
          render();
        });
      });
    };

    wireSeg(tierBtns, (b) => (tier = b.dataset.tier as Tier));
    wireSeg(modeBtns, (b) => (mode = b.dataset.mode as Mode));
    wireSeg(audBtns, (b) => (audience = b.dataset.aud as 'dev' | 'home'));

    typEl.addEventListener('change', () => {
      syncWaterCool();
      syncMaintLabel();
      render();
    });
    [areaEl, acEl, waterEl].forEach((el) => el.addEventListener('input', render));

    // lead capture — AJAX submit so the page state survives
    const emailForm = root.querySelector('.email-form') as HTMLFormElement | null;
    emailForm?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      try {
        const res = await fetch(emailForm.action, {
          method: 'POST',
          body: new FormData(emailForm),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          $('email-block').hidden = true;
          $('email-sent').hidden = false;
        } else {
          emailForm.submit();
        }
      } catch {
        emailForm.submit();
      }
    });

    syncWaterCool();
    syncMaintLabel();
    render();
  }
</script>
