---
// interactive panama building cost estimator.
// one component, locale-driven. the client island lives at the bottom and
// imports the pure model from src/lib/costModel.ts.
import type { Locale } from '../i18n/strings';
import {
  CAPEX_M2,
  EUI,
  DENSITY,
  PERCAPITA,
  MAINT_M2,
  type Typology,
  type Range,
} from '../lib/costModel';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// server-side range formatters for the assumptions table
const rng = (x: Range, dp = 0): string => {
  const f = (n: number) => n.toFixed(dp);
  return x.low === x.high ? f(x.low) : `${f(x.low)}–${f(x.high)}`;
};
const money = (x: Range): string => `$${rng(x)}`;
const money2 = (x: Range): string => `$${rng(x, 2)}`;

const S = {
  es: {
    areaLabel: 'área construida',
    typLabel: 'categoría de edificio',
    typ: {
      'residential-sf': 'residencial · unifamiliar',
      'residential-mf': 'residencial · multifamiliar',
      office: 'oficinas',
      commercial: 'comercial / retail',
      institutional: 'institucional',
    },
    tierLabel: 'nivel de acabados',
    tier: { basic: 'básico', standard: 'estándar', premium: 'premium' },
    acLabel: 'porcentaje con aire acondicionado',
    waterCooled: 'a/a por agua (torre de enfriamiento)',
    waterCooledHint: 'solo comercial / institucional',
    inputsEb: '// tu proyecto',
    inputsH: 'describe el edificio.',
    capexEb: '// costo de construcción',
    capexH: 'capex estimado.',
    construction: 'construcción (costo directo)',
    totalDev: 'costo total de desarrollo',
    softNote: 'el total incluye ~15 % de costos indirectos: diseño, permisos municipales y legal.',
    excludesNote: 'no incluye terreno, mobiliario ni el itbms (7 %) sobre servicios profesionales.',
    perM2: '$/m² aplicado',
    energyEb: '// costo de energía',
    energyH: 'electricidad mensual, lado a lado.',
    scenRegular: 'edificio típico',
    scenSustainable: 'código sostenible · res v.2',
    use: {
      ac: 'aire acondicionado',
      lighting: 'iluminación',
      plug: 'equipos y enchufes',
      other: 'otros',
    },
    total: 'total',
    savingsEb: '// la prueba',
    savingsLabel: 'ahorro anual diseñando bajo el código sostenible.',
    opexEb: '// operación mensual',
    opexH: 'opex mensual total, lado a lado.',
    energyLine: 'energía',
    water: 'agua + alcantarillado',
    maintenancePH: 'mantenimiento (ph)',
    maintenanceHome: 'conservación / upkeep',
    lcEb: '// costo a 30 años',
    lcH: 'lo que cuesta a lo largo de su vida útil.',
    lcRegular: 'edificio típico',
    lcSustainable: 'código sostenible',
    lcSavingsLabel: 'menos a 30 años diseñando bajo el código sostenible.',
    lcNote: 'valor presente de la construcción más 30 años de operación, descontados al 6.25 % (tasa hipotecaria de referencia, sbp). la diferencia es el valor descontado de diseñar eficiente.',
    assumptionsEb: '// qué hay detrás del cálculo',
    assumptionsH: 'los promedios por categoría.',
    assumptionsIntro:
      'cada estimación parte de promedios de mercado y de las líneas base del reglamento de edificación sostenible (res v.2). estos son los valores que usa la calculadora para cada categoría de edificio. el consumo de iluminación, equipos y otros se estima por m² y no depende del aire acondicionado; solo el enfriamiento varía con el porcentaje de a/a. la columna sostenible reduce cada uso por separado (enfriamiento −40 %, iluminación −30 %, equipos −5 %), dentro del rango de 20–38.8 % que documenta el reglamento.',
    aCapex: 'construcción (estándar)',
    aEnergy: 'energía (100 % a/a)',
    aEnergyUnit: 'kwh/m²·año',
    aWater: 'agua',
    aWaterUnit: 'l/persona·día',
    aOcc: 'ocupación',
    aOccUnit: 'pers./100 m²',
    aOccCap: 'máx. 6 por hogar',
    aMaint: 'mantenimiento',
    aMaintUnit: '$/m²·mes',
    sourcesEb: '// fuentes',
    sourcesH: 'de dónde salen los números.',
    srcCapex: 'costos de construcción (capex)',
    srcEnergy: 'tarifas eléctricas (asep)',
    srcCode: 'línea base energética (res v.2)',
    srcWater: 'agua y alcantarillado (idaan / asep)',
    srcMaint: 'mantenimiento (propiedad horizontal)',
    disclaimer:
      'estimación con fines orientativos, no es una cotización. los rangos se derivan de datos públicos de 2026 (capex de mercado, tarifas asep, bloques idaan, cuotas ph y las líneas base de eui del reglamento de edificación sostenible res v.2). cada proyecto real depende del sitio, el suelo, el diseño y el momento del mercado. para un número que puedas usar, hablemos.',
  },
  en: {
    areaLabel: 'built area',
    typLabel: 'building category',
    typ: {
      'residential-sf': 'residential · single-family',
      'residential-mf': 'residential · multi-family',
      office: 'office',
      commercial: 'commercial / retail',
      institutional: 'institutional',
    },
    tierLabel: 'finish tier',
    tier: { basic: 'basic', standard: 'standard', premium: 'premium' },
    acLabel: 'percent air-conditioned',
    waterCooled: 'water-cooled a/c (cooling tower)',
    waterCooledHint: 'commercial / institutional only',
    inputsEb: '// your project',
    inputsH: 'describe the building.',
    capexEb: '// construction cost',
    capexH: 'estimated capex.',
    construction: 'construction (hard cost)',
    totalDev: 'total development cost',
    softNote: 'total includes ~15 % indirect costs: design, municipal permits, and legal.',
    excludesNote: 'excludes land, furniture/FF&E, and the 7 % ITBMS on professional services.',
    perM2: '$/m² applied',
    energyEb: '// energy cost',
    energyH: 'monthly electricity, side by side.',
    scenRegular: 'typical building',
    scenSustainable: 'sustainable code · res v.2',
    use: {
      ac: 'air conditioning',
      lighting: 'lighting',
      plug: 'plug loads',
      other: 'other',
    },
    total: 'total',
    savingsEb: '// the proof',
    savingsLabel: 'saved per year by designing to the sustainable code.',
    opexEb: '// monthly operation',
    opexH: 'total monthly opex, side by side.',
    energyLine: 'energy',
    water: 'water + sewer',
    maintenancePH: 'maintenance (ph)',
    maintenanceHome: 'upkeep / conservación',
    lcEb: '// 30-year cost',
    lcH: 'what it costs across its useful life.',
    lcRegular: 'typical building',
    lcSustainable: 'sustainable code',
    lcSavingsLabel: 'less over 30 years by designing to the sustainable code.',
    lcNote: 'present value of construction plus 30 years of operation, discounted at 6.25 % (the SBP benchmark mortgage rate). the gap is the discounted value of designing efficiently.',
    assumptionsEb: '// what is behind the numbers',
    assumptionsH: 'the per-category averages.',
    assumptionsIntro:
      'every estimate starts from market averages and the energy-use baselines of the res v.2 sustainable-building code. these are the values the calculator uses for each building category. lighting, plug loads and other are estimated per m² and do not depend on air-conditioning; only cooling varies with the % a/c. the sustainable column reduces each end use separately (cooling −40 %, lighting −30 %, plug −5 %), within the 20–38.8 % range the code documents.',
    aCapex: 'construction (standard)',
    aEnergy: 'energy (100 % a/c)',
    aEnergyUnit: 'kwh/m²·yr',
    aWater: 'water',
    aWaterUnit: 'l/person·day',
    aOcc: 'occupancy',
    aOccUnit: 'ppl/100 m²',
    aOccCap: 'max 6 per household',
    aMaint: 'maintenance',
    aMaintUnit: '$/m²·mo',
    sourcesEb: '// sources',
    sourcesH: 'where the numbers come from.',
    srcCapex: 'construction costs (capex)',
    srcEnergy: 'electricity tariffs (asep)',
    srcCode: 'energy baseline (res v.2)',
    srcWater: 'water + sewer (idaan / asep)',
    srcMaint: 'maintenance (horizontal property)',
    disclaimer:
      'estimate for guidance only, not a quote. ranges are derived from public 2026 data (market capex, asep tariffs, idaan blocks, ph fees, and the energy-use baselines of panama’s res v.2 sustainable-building code). a real project depends on site, soil, design, and market timing. for a number you can use, let’s talk.',
  },
}[locale];

const typOrder = [
  'residential-sf',
  'residential-mf',
  'office',
  'commercial',
  'institutional',
] as const;
const useOrder = ['ac', 'lighting', 'plug', 'other'] as const;

// grouped sources (shared across locales — official document titles)
const sources = [
  {
    group: S.srcCapex,
    items: [
      { name: 'INEC · Edificaciones particulares por provincia (1er sem. 2024)', url: 'https://www.inec.gob.pa/archivos/P053342420241216160104Cuadro%2013.pdf' },
      { name: 'Contraloría · Índice de precios de materiales (IPMC, 2024–2025)', url: 'https://www.inec.gob.pa/archivos/07055475IPMC%20%20Enero%2024-25.pdf' },
      { name: 'Contraloría · Costos unitarios de acabados y remodelaciones', url: 'https://www.contraloria.gob.pa/wp-content/uploads/2024/02/2324P0-ACABADOS-Y-REMODELACIONES.pdf' },
      { name: 'Contraloría · Base de datos de costo directo', url: 'https://www.contraloria.gob.pa/wp-content/uploads/2024/07/P2-BASE-DE-DATOS-DE-COSTO-DIRECTO.pdf' },
    ],
  },
  {
    group: S.srcEnergy,
    items: [
      { name: 'ASEP · Pliego tarifario, clientes regulados (2026)', url: 'https://asep.gob.pa/wp-content/uploads/electricidad/tarifas/01_tarifas_clientes_regulados/tarifas_2023-2026/2026/abril/I_t_2026.pdf' },
      { name: 'La Prensa · Ajuste de tarifas eléctricas y fin del FET adicional (2026)', url: 'https://www.prensa.com/economia/tarifas-electricas-se-ajustan-a-partir-del-1-de-enero-de-2026-la-mayoria-de-los-usuarios-no-tendra-aumentos-en-su-factura/' },
      { name: 'Naturgy · Tarifas EDEMET / EDECHI', url: 'https://www.naturgy.com.pa/hogar/distribucion-de-electricidad/tarifas/' },
    ],
  },
  {
    group: S.srcCode,
    items: [
      { name: 'Gaceta Oficial · Guía de construcción sostenible', url: 'https://www.gacetaoficial.gob.pa/pdfTemp/28165/GacetaNo_28165_20161124.pdf' },
      { name: 'JTIA · Reglamento de edificación sostenible (RES V.2)', url: 'https://www.gacetaoficial.gob.pa/pdfTemp/29726/96966.pdf' },
      { name: 'Panamá Green Building Council · Avance de sostenibilidad', url: 'https://panamagbc.org/wp-content/uploads/2026/04/Avance-de-Sostenibilidad-en-la-edificacion-en-Panama.pdf' },
    ],
  },
  {
    group: S.srcWater,
    items: [
      { name: 'ASEP · Tarifas de agua potable y alcantarillado (IDAAN)', url: 'https://asep.gob.pa/wp-content/uploads/agua/tarifas/tarifa_1_IDAAN.pdf' },
      { name: 'ASEP · Resolución AN-3491 (agua)', url: 'https://www.asep.gob.pa/wp-content/uploads/agua/tarifas/anno_3491_agua.pdf' },
      { name: 'La Prensa · Inversión en agua potable en el presupuesto del Estado', url: 'https://www.prensa.com/sociedad/el-agua-potable-no-ha-sido-prioridad-para-el-estado/' },
    ],
  },
  {
    group: S.srcMaint,
    items: [
      { name: 'Ley 284 de 2022 · Régimen de propiedad horizontal', url: 'https://www.arispeabogado.com/p/cobrar-cuotas-mantenimiento-ph-panama.html' },
      { name: 'H&H Facility Management · Cuotas de gastos comunes', url: 'https://www.hhfacilitymanagement.com/cuotas/cuales-son-las-cuotas-de-gastos-comunes-en-un-ph/' },
    ],
  },
];
---

<section class="calc" data-locale={locale} data-maint-ph={S.maintenancePH} data-maint-home={S.maintenanceHome}>
  <div class="calc-grid">
    <!-- ============ inputs ============ -->
    <div class="calc-inputs">
      <div class="eyebrow">{S.inputsEb}</div>
      <h2 class="calc-h">{S.inputsH}</h2>

      <div class="field">
        <label for="ci-area">{S.areaLabel} <span class="val" id="ci-area-val">250 m²</span></label>
        <input type="range" id="ci-area" min="50" max="10000" step="10" value="250" />
      </div>

      <div class="field">
        <label for="ci-typ">{S.typLabel}</label>
        <select id="ci-typ">
          {typOrder.map((k) => <option value={k}>{S.typ[k]}</option>)}
        </select>
      </div>

      <div class="field">
        <label>{S.tierLabel}</label>
        <div class="seg" role="group" id="ci-tier">
          <button type="button" class="seg-btn" data-tier="basic">{S.tier.basic}</button>
          <button type="button" class="seg-btn active" data-tier="standard">{S.tier.standard}</button>
          <button type="button" class="seg-btn" data-tier="premium">{S.tier.premium}</button>
        </div>
      </div>

      <div class="field">
        <label for="ci-ac">{S.acLabel} <span class="val" id="ci-ac-val">80 %</span></label>
        <input type="range" id="ci-ac" min="0" max="100" step="5" value="80" />
      </div>

      <div class="checks">
        <label class="check" id="ci-watercool-label">
          <input type="checkbox" id="ci-watercool" />
          <span>{S.waterCooled} <span class="check-hint">· {S.waterCooledHint}</span></span>
        </label>
      </div>
    </div>

    <!-- ============ results ============ -->
    <div class="calc-results">
      <!-- capex -->
      <div class="res-block">
        <div class="eyebrow">{S.capexEb}</div>
        <h3 class="res-h">{S.capexH}</h3>
        <div class="res-row">
          <span class="rk">{S.construction}</span>
          <span class="rv" id="r-capex-hard">—</span>
        </div>
        <div class="res-row strong">
          <span class="rk">{S.totalDev}</span>
          <span class="rv" id="r-capex-total">—</span>
        </div>
        <p class="res-note"><span id="r-capex-m2">—</span> · {S.perM2}</p>
        <p class="res-note">{S.softNote}</p>
        <p class="res-note">{S.excludesNote}</p>
      </div>

      <!-- energy, two scenarios -->
      <div class="res-block">
        <div class="eyebrow">{S.energyEb}</div>
        <h3 class="res-h">{S.energyH}</h3>
        <div class="scen-grid">
          <div class="scen">
            <div class="scen-name">{S.scenRegular}</div>
            {useOrder.map((u) => (
              <div class="res-row sm">
                <span class="rk">{S.use[u]}</span>
                <span class="rv" id={`r-en-reg-${u}`}>—</span>
              </div>
            ))}
            <div class="res-row sm strong">
              <span class="rk">{S.total}</span>
              <span class="rv" id="r-en-reg-total">—</span>
            </div>
          </div>
          <div class="scen scen-alt">
            <div class="scen-name">{S.scenSustainable}</div>
            {useOrder.map((u) => (
              <div class="res-row sm">
                <span class="rk">{S.use[u]}</span>
                <span class="rv" id={`r-en-sus-${u}`}>—</span>
              </div>
            ))}
            <div class="res-row sm strong">
              <span class="rk">{S.total}</span>
              <span class="rv" id="r-en-sus-total">—</span>
            </div>
          </div>
        </div>
      </div>

      <!-- proof: annual savings -->
      <div class="res-proof">
        <div class="proof-num" id="r-savings">—</div>
        <div class="proof-copy">
          <div class="eyebrow amber">{S.savingsEb}</div>
          <p>{S.savingsLabel}</p>
        </div>
      </div>

      <!-- monthly opex roll-up, two scenarios -->
      <div class="res-block">
        <div class="eyebrow">{S.opexEb}</div>
        <h3 class="res-h">{S.opexH}</h3>
        <div class="scen-grid">
          <div class="scen">
            <div class="scen-name">{S.scenRegular}</div>
            <div class="res-row sm"><span class="rk">{S.energyLine}</span><span class="rv" id="r-opex-reg-energy">—</span></div>
            <div class="res-row sm"><span class="rk">{S.water}</span><span class="rv" id="r-opex-reg-water">—</span></div>
            <div class="res-row sm"><span class="rk js-maint-label">{S.maintenancePH}</span><span class="rv" id="r-opex-reg-maint">—</span></div>
            <div class="res-row sm strong"><span class="rk">{S.total}</span><span class="rv" id="r-opex-reg-total">—</span></div>
          </div>
          <div class="scen scen-alt">
            <div class="scen-name">{S.scenSustainable}</div>
            <div class="res-row sm"><span class="rk">{S.energyLine}</span><span class="rv" id="r-opex-sus-energy">—</span></div>
            <div class="res-row sm"><span class="rk">{S.water}</span><span class="rv" id="r-opex-sus-water">—</span></div>
            <div class="res-row sm"><span class="rk js-maint-label">{S.maintenancePH}</span><span class="rv" id="r-opex-sus-maint">—</span></div>
            <div class="res-row sm strong"><span class="rk">{S.total}</span><span class="rv" id="r-opex-sus-total">—</span></div>
          </div>
        </div>
      </div>

      <!-- lifecycle: 30-year total cost of ownership -->
      <div class="res-block">
        <div class="eyebrow">{S.lcEb}</div>
        <h3 class="res-h">{S.lcH}</h3>
        <div class="scen-grid">
          <div class="scen">
            <div class="scen-name">{S.lcRegular}</div>
            <div class="res-row sm strong"><span class="rk">{S.total}</span><span class="rv" id="r-lc-reg">—</span></div>
          </div>
          <div class="scen scen-alt">
            <div class="scen-name">{S.lcSustainable}</div>
            <div class="res-row sm strong"><span class="rk">{S.total}</span><span class="rv" id="r-lc-sus">—</span></div>
          </div>
        </div>
        <div class="res-proof lc-proof">
          <div class="proof-num" id="r-lc-savings">—</div>
          <div class="proof-copy">
            <p>{S.lcSavingsLabel}</p>
          </div>
        </div>
        <p class="res-note">{S.lcNote}</p>
      </div>

      <p class="disclaimer">{S.disclaimer}</p>
    </div>
  </div>

  <!-- ============ assumptions: per-category averages ============ -->
  <div class="calc-assumptions">
    <div class="eyebrow">{S.assumptionsEb}</div>
    <h2 class="assum-h">{S.assumptionsH}</h2>
    <p class="assum-intro">{S.assumptionsIntro}</p>
    <div class="assum-grid">
      {typOrder.map((k) => (
        <div class="assum-card">
          <div class="assum-title">{S.typ[k]}</div>
          <div class="assum-row"><span class="ak">{S.aCapex}</span><span class="av">{money(CAPEX_M2[k].standard)}<span class="au">/m²</span></span></div>
          <div class="assum-row"><span class="ak">{S.aEnergy}</span><span class="av">{rng(EUI[k].fc)}<span class="au">{S.aEnergyUnit}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aWater}</span><span class="av">{rng(PERCAPITA[k])}<span class="au">{S.aWaterUnit}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aOcc}</span><span class="av">{DENSITY[k]}<span class="au">{S.aOccUnit}{k === 'residential-sf' ? ` · ${S.aOccCap}` : ''}</span></span></div>
          <div class="assum-row"><span class="ak">{S.aMaint}</span><span class="av">{money2(MAINT_M2[k].standard)}<span class="au">{S.aMaintUnit}</span></span></div>
        </div>
      ))}
    </div>
  </div>

  <!-- ============ sources ============ -->
  <div class="calc-sources">
    <div class="eyebrow">{S.sourcesEb}</div>
    <h2 class="assum-h">{S.sourcesH}</h2>
    <div class="src-grid">
      {sources.map((s) => (
        <div class="src-group">
          <div class="src-group-name">{s.group}</div>
          <ul>
            {s.items.map((it) => (
              <li><a href={it.url} target="_blank" rel="noopener nofollow">{it.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .calc { padding: 8px 0 24px; }
  .calc-grid { display: grid; grid-template-columns: 360px 1fr; gap: 56px; align-items: start; }
  @media (max-width: 900px) { .calc-grid { grid-template-columns: 1fr; gap: 40px; } }

  .calc-inputs { position: sticky; top: 24px; }
  @media (max-width: 900px) { .calc-inputs { position: static; } }
  .calc-inputs .eyebrow,
  .res-block .eyebrow,
  .proof-copy .eyebrow,
  .calc-assumptions .eyebrow,
  .calc-sources .eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 400; margin-bottom: 12px; display: inline-block; }
  .calc-h { font-size: 22px; font-weight: 300; letter-spacing: -0.015em; margin: 0 0 28px; }

  .field { margin-bottom: 24px; }
  .field label { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute-on-paper); font-weight: 400; margin-bottom: 10px; }
  .field label .val { color: var(--ink-on-paper); font-size: 13px; letter-spacing: 0; text-transform: none; }
  input[type='range'] { width: 100%; accent-color: var(--amber); cursor: pointer; }
  select { width: 100%; font-family: inherit; font-size: 14px; font-weight: 300; padding: 10px 12px; background: var(--paper); border: 1px solid var(--line-on-paper); color: var(--ink-on-paper); border-radius: 0; cursor: pointer; }
  select:focus { outline: 1px solid var(--amber); }

  .seg { display: flex; border: 1px solid var(--line-on-paper); }
  .seg-btn { flex: 1; background: none; border: none; border-right: 1px solid var(--line-on-paper); font-family: inherit; font-size: 12px; letter-spacing: 0.04em; padding: 10px 4px; cursor: pointer; color: var(--mute-on-paper); transition: all 0.15s; }
  .seg-btn:last-child { border-right: none; }
  .seg-btn:hover { color: var(--ink-on-paper); }
  .seg-btn.active { background: var(--amber); color: #1a1a1a; }

  .checks { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .check { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; font-weight: 300; color: var(--ink-on-paper); cursor: pointer; line-height: 1.4; }
  .check input { accent-color: var(--amber); width: 16px; height: 16px; cursor: pointer; margin-top: 2px; flex: none; }
  .check-hint { color: var(--mute-on-paper-2); font-size: 11px; }
  .check.disabled { opacity: 0.45; cursor: not-allowed; }
  .check.disabled input { cursor: not-allowed; }

  .calc-results { display: flex; flex-direction: column; gap: 28px; }
  .res-block { border: 1px solid var(--line-on-paper); padding: 28px; }
  .res-h { font-size: 18px; font-weight: 300; letter-spacing: -0.01em; margin: 0 0 20px; }
  .res-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 9px 0; border-top: 1px solid var(--line-on-paper-2); }
  .res-row:first-of-type { border-top: none; }
  .res-row.sm { padding: 6px 0; }
  .res-row .rk { font-size: 13px; color: var(--mute-on-paper); font-weight: 300; }
  .res-row .rv { font-size: 14px; font-weight: 400; font-feature-settings: 'tnum' 1; text-align: right; white-space: nowrap; }
  .res-row.strong .rk { color: var(--ink-on-paper); }
  .res-row.strong .rv { font-size: 15px; }
  .res-note { font-size: 12px; color: var(--mute-on-paper); font-weight: 300; margin: 12px 0 0; line-height: 1.55; }

  .scen-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 540px) { .scen-grid { grid-template-columns: 1fr; gap: 28px; } }
  .scen-name { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--line-on-paper); }
  .scen-alt .scen-name { color: var(--ink-on-paper); }

  .res-proof { display: flex; align-items: center; gap: 28px; padding: 8px 4px; }
  @media (max-width: 540px) { .res-proof { flex-direction: column; align-items: flex-start; gap: 12px; } }
  .proof-num { font-size: clamp(40px, 7vw, 72px); color: var(--amber); letter-spacing: -0.04em; line-height: 0.95; font-weight: 300; font-feature-settings: 'tnum' 1, 'lnum' 1; white-space: nowrap; }
  .proof-copy p { font-size: 14px; line-height: 1.5; color: var(--ink-on-paper); font-weight: 300; margin: 0; max-width: 30ch; }
  .lc-proof { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line-on-paper-2); }
  .lc-proof .proof-num { font-size: clamp(32px, 5vw, 52px); }

  .disclaimer { font-size: 13px; line-height: 1.7; color: var(--mute-on-paper); font-weight: 300; margin: 0; max-width: 72ch; padding: 20px 24px; border-left: 2px solid var(--line-on-paper); background: var(--paper-2); }

  /* assumptions */
  .calc-assumptions { padding: 64px 0 8px; border-top: 1px solid var(--line-on-paper); margin-top: 48px; }
  .assum-h { font-size: clamp(22px, 2.6vw, 30px); font-weight: 300; letter-spacing: -0.015em; margin: 0 0 16px; }
  .assum-intro { font-size: 14px; line-height: 1.65; color: var(--mute-on-paper); font-weight: 300; max-width: 70ch; margin: 0 0 36px; }
  .assum-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 900px) { .assum-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .assum-grid { grid-template-columns: 1fr; } }
  .assum-card { border: 1px solid var(--line-on-paper); padding: 22px; }
  .assum-title { font-size: 14px; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line-on-paper); }
  .assum-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 7px 0; }
  .assum-row .ak { font-size: 12px; color: var(--mute-on-paper); font-weight: 300; }
  .assum-row .av { font-size: 13px; font-weight: 400; text-align: right; font-feature-settings: 'tnum' 1; white-space: nowrap; }
  .assum-row .au { font-size: 10px; color: var(--mute-on-paper-2); margin-left: 4px; }

  /* sources */
  .calc-sources { padding: 56px 0 8px; border-top: 1px solid var(--line-on-paper); margin-top: 48px; }
  .src-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 48px; }
  @media (max-width: 700px) { .src-grid { grid-template-columns: 1fr; } }
  .src-group-name { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute-on-paper-2); font-weight: 400; margin-bottom: 12px; }
  .src-group ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .src-group li { font-size: 13px; line-height: 1.45; font-weight: 300; }
  .src-group a { color: var(--ink-on-paper); border-bottom: 1px solid var(--line-on-paper-2); }
  .src-group a:hover { color: var(--amber); border-bottom-color: var(--amber); }
</style>

<script>
  import { estimateAll, type CalculatorInputs, type Tier, type Typology, type Range } from '../lib/costModel';

  const root = document.querySelector('.calc') as HTMLElement;
  if (root) {
    const locale = (document.documentElement.lang === 'en' ? 'en' : 'es') as 'en' | 'es';
    const money = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-PA', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    });
    const num = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-PA', { maximumFractionDigits: 0 });

    const fmtRange = (x: Range): string => {
      const lo = Math.round(x.low);
      const hi = Math.round(x.high);
      if (lo === hi) return money.format(lo);
      return `${money.format(lo)} – ${money.format(hi)}`;
    };

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const areaEl = $('ci-area') as HTMLInputElement;
    const acEl = $('ci-ac') as HTMLInputElement;
    const typEl = $('ci-typ') as HTMLSelectElement;
    const waterEl = $('ci-watercool') as HTMLInputElement;
    const waterLabel = $('ci-watercool-label') as HTMLElement;
    const tierBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-tier .seg-btn'));
    const maintLabels = Array.from(document.querySelectorAll<HTMLElement>('.js-maint-label'));
    const maintPH = root.dataset.maintPh ?? 'maintenance (ph)';
    const maintHome = root.dataset.maintHome ?? 'upkeep';
    let tier: Tier = 'standard';

    // water-cooled AC only applies to non-residential cooling towers
    function syncWaterCool() {
      const isRes = typEl.value.startsWith('residential');
      waterEl.disabled = isRes;
      waterLabel.classList.toggle('disabled', isRes);
      if (isRes) waterEl.checked = false;
    }

    // a standalone single-family home is not a PH (horizontal property);
    // its recurring cost is private upkeep, so the label switches.
    function syncMaintLabel() {
      const label = typEl.value === 'residential-sf' ? maintHome : maintPH;
      maintLabels.forEach((el) => (el.textContent = label));
    }

    function render() {
      const input: CalculatorInputs = {
        area: Number(areaEl.value),
        typology: typEl.value as Typology,
        tier,
        pctAC: Number(acEl.value) / 100,
        waterCooledAC: waterEl.checked,
      };

      $('ci-area-val').textContent = `${num.format(input.area)} m²`;
      $('ci-ac-val').textContent = `${acEl.value} %`;

      const e = estimateAll(input);

      // capex
      $('r-capex-hard').textContent = fmtRange(e.capex.hard);
      $('r-capex-total').textContent = fmtRange(e.capex.total);
      $('r-capex-m2').textContent = fmtRange(e.capex.perM2);

      // energy per use
      (['ac', 'lighting', 'plug', 'other'] as const).forEach((u) => {
        $(`r-en-reg-${u}`).textContent = fmtRange(e.energy.regular.perUse[u]);
        $(`r-en-sus-${u}`).textContent = fmtRange(e.energy.sustainable.perUse[u]);
      });
      $('r-en-reg-total').textContent = fmtRange(e.energy.regular.total);
      $('r-en-sus-total').textContent = fmtRange(e.energy.sustainable.total);

      // proof: annual savings (midpoint headline)
      const savMid = Math.round((e.energy.annualSavings.low + e.energy.annualSavings.high) / 2);
      $('r-savings').textContent = money.format(Math.max(savMid, 0));

      // opex, two scenarios (water + maintenance identical both sides)
      $('r-opex-reg-energy').textContent = fmtRange(e.energy.regular.total);
      $('r-opex-sus-energy').textContent = fmtRange(e.energy.sustainable.total);
      $('r-opex-reg-water').textContent = fmtRange(e.water.monthly);
      $('r-opex-sus-water').textContent = fmtRange(e.water.monthly);
      $('r-opex-reg-maint').textContent = fmtRange(e.maintenance.monthly);
      $('r-opex-sus-maint').textContent = fmtRange(e.maintenance.monthly);
      $('r-opex-reg-total').textContent = fmtRange(e.monthlyOpex.regular);
      $('r-opex-sus-total').textContent = fmtRange(e.monthlyOpex.sustainable);

      // lifecycle: 30-year total cost of ownership
      $('r-lc-reg').textContent = fmtRange(e.lifecycle.regular);
      $('r-lc-sus').textContent = fmtRange(e.lifecycle.sustainable);
      const lcSavMid = Math.round((e.lifecycle.savings.low + e.lifecycle.savings.high) / 2);
      $('r-lc-savings').textContent = money.format(Math.max(lcSavMid, 0));
    }

    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tierBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        tier = btn.dataset.tier as Tier;
        render();
      });
    });
    typEl.addEventListener('change', () => {
      syncWaterCool();
      syncMaintLabel();
      render();
    });
    [areaEl, acEl, waterEl].forEach((el) => el.addEventListener('input', render));

    syncWaterCool();
    syncMaintLabel();
    render();
  }
</script>
