<script>
  import { estimateAll, type CalculatorInputs, type Tier, type Typology, type Mode, type ClimateZone, type WWR, type Range } from '../lib/costModel';

  const root = document.querySelector('.calc') as HTMLElement;
  if (root) {
    const d = root.dataset;
    const locale = (document.documentElement.lang === 'en' ? 'en' : 'es') as 'en' | 'es';
    const money = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-PA', {
      style: 'currency',
      currency: 'USD',
      currencyDisplay: 'code',
      maximumFractionDigits: 0,
    });
    const num = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-PA', { maximumFractionDigits: 0 });
    const mid = (x: Range) => (x.low + x.high) / 2;
    const fmt = (x: Range) => money.format(Math.round(mid(x)));

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const areaEl = $('ci-area') as HTMLInputElement;
    const acEl = $('ci-ac') as HTMLInputElement;
    const typEl = $('ci-typ') as HTMLSelectElement;
    const climEl = $('ci-climate') as HTMLSelectElement;
    const discEl = $('ci-disc') as HTMLInputElement;
    const escEl = $('ci-esc') as HTMLInputElement;
    const yearsEl = $('ci-years') as HTMLInputElement;
    const waterEl = $('ci-watercool') as HTMLInputElement;
    const waterLabel = $('ci-watercool-label') as HTMLElement;
    const tierBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-tier .seg-btn'));
    const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-mode .seg-btn'));
    const wwrBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-wwr .seg-btn'));
    const horBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ci-hor .seg-btn'));
    const maintLabels = Array.from(document.querySelectorAll<HTMLElement>('.js-maint-label'));
    const maintPH = d.maintPh ?? 'maintenance (ph)';
    const maintHome = d.maintHome ?? 'upkeep';

    let tier: Tier = 'standard';
    let mode: Mode = 'new';
    let wwr: WWR = 50;
    let horizon: 'month' | 'year' | 'lifetime' = 'lifetime';

    function syncWaterCool() {
      const isRes = typEl.value.startsWith('residential');
      waterEl.disabled = isRes;
      waterLabel.classList.toggle('disabled', isRes);
      if (isRes) waterEl.checked = false;
    }
    function syncMaintLabel() {
      const label = typEl.value === 'residential-sf' ? maintHome : maintPH;
      maintLabels.forEach((el) => (el.textContent = label));
    }

    function render() {
      const input: CalculatorInputs = {
        area: Number(areaEl.value),
        typology: typEl.value as Typology,
        tier,
        pctAC: Number(acEl.value) / 100,
        waterCooledAC: waterEl.checked,
        mode,
        climate: climEl.value as ClimateZone,
        wwr,
        sustainablePremiumPct: 0.04,
        discountRate: Number(discEl.value) / 100,
        tariffEscalation: Number(escEl.value) / 100,
        horizonYears: Number(yearsEl.value),
      };

      $('ci-area-val').textContent = `${num.format(input.area)} m²`;
      $('ci-ac-val').textContent = `${acEl.value} %`;

      const e = estimateAll(input);
      const reno = mode === 'renovation';

      // capex
      $('r-capex-eb').textContent = (reno ? d.capexEbReno : d.capexEb) ?? '';
      $('r-capex-h').textContent = (reno ? d.capexHReno : d.capexH) ?? '';
      $('r-capex-klabel').textContent = (reno ? d.capexKReno : d.capexK) ?? '';
      $('r-capex-hard').textContent = fmt(e.capex.hard);
      $('r-capex-typical').textContent = fmt(e.capex.typicalTotal);
      $('r-capex-sus').textContent = fmt(e.capex.sustainableTotal);
      $('r-capex-premium').textContent = '+ ' + fmt(e.capex.premium);
      $('r-capex-m2').textContent = fmt(e.capex.perM2);
      $('r-payback').textContent =
        e.paybackYears == null
          ? (d.paybackNone ?? '—')
          : `${e.paybackYears.toFixed(1)} ${d.paybackUnit ?? ''}`;

      // energy per use + totals
      (['ac', 'lighting', 'plug', 'other'] as const).forEach((u) => {
        $(`r-en-reg-${u}`).textContent = fmt(e.energy.regular.perUse[u]);
        $(`r-en-sus-${u}`).textContent = fmt(e.energy.sustainable.perUse[u]);
      });
      $('r-en-reg-total').textContent = fmt(e.energy.regular.total);
      $('r-en-sus-total').textContent = fmt(e.energy.sustainable.total);
      $('r-savings').textContent = money.format(Math.max(Math.round(mid(e.annualSavings)), 0));

      // opex (energy / water / maint now differ between columns)
      $('r-opex-reg-energy').textContent = fmt(e.opex.regular.energy);
      $('r-opex-sus-energy').textContent = fmt(e.opex.sustainable.energy);
      $('r-opex-reg-water').textContent = fmt(e.opex.regular.water);
      $('r-opex-sus-water').textContent = fmt(e.opex.sustainable.water);
      $('r-opex-reg-maint').textContent = fmt(e.opex.regular.maint);
      $('r-opex-sus-maint').textContent = fmt(e.opex.sustainable.maint);
      $('r-opex-reg-total').textContent = fmt(e.opex.regular.total);
      $('r-opex-sus-total').textContent = fmt(e.opex.sustainable.total);

      // lifecycle
      $('r-lc-reg').textContent = fmt(e.lifecycle.regular);
      $('r-lc-sus').textContent = fmt(e.lifecycle.sustainable);

      // hero adapts to horizon
      let heroVal: number;
      let heroLabel: string;
      if (horizon === 'month') {
        heroVal = mid(e.monthlySavings);
        heroLabel = d.lcLabelMonth ?? '';
      } else if (horizon === 'year') {
        heroVal = mid(e.annualSavings);
        heroLabel = d.lcLabelYear ?? '';
      } else {
        heroVal = mid(e.lifecycle.savings);
        heroLabel = d.lcLabelLife ?? '';
      }
      $('r-lc-savings').textContent = money.format(Math.max(Math.round(heroVal), 0));
      $('r-lc-savings-label').textContent = heroLabel;

      // lead-capture summary
      const summary = $('email-summary') as HTMLInputElement | null;
      if (summary) {
        summary.value = `${mode} · ${input.typology} · ${input.area} m² · ${tier} · ${climEl.value} · wwr ${wwr}% · a/c ${acEl.value}% · capex ${fmt(e.capex.typicalTotal)}→${fmt(e.capex.sustainableTotal)} · opex ${fmt(e.opex.regular.total)}→${fmt(e.opex.sustainable.total)}/mes`;
      }

      // bars (central values, shared scale = larger total)
      const setW = (id: string, pct: number) => {
        const el = document.getElementById(id);
        if (el) el.style.width = `${Math.max(0, Math.min(100, pct))}%`;
      };
      const enMax = mid(e.energy.regular.total) || 1;
      (['ac', 'lighting', 'plug', 'other'] as const).forEach((u) => {
        setW(`bar-reg-${u}`, (mid(e.energy.regular.perUse[u]) / enMax) * 100);
        setW(`bar-sus-${u}`, (mid(e.energy.sustainable.perUse[u]) / enMax) * 100);
      });
      const lcMax = mid(e.lifecycle.regular) || 1;
      setW('bar-lc-reg', (mid(e.lifecycle.regular) / lcMax) * 100);
      setW('bar-lc-sus', (mid(e.lifecycle.sustainable) / lcMax) * 100);
    }

    const wireSeg = (btns: HTMLButtonElement[], onPick: (b: HTMLButtonElement) => void) => {
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          btns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          onPick(btn);
          render();
        });
      });
    };
    wireSeg(tierBtns, (b) => (tier = b.dataset.tier as Tier));
    wireSeg(modeBtns, (b) => (mode = b.dataset.mode as Mode));
    wireSeg(wwrBtns, (b) => (wwr = Number(b.dataset.wwr) as WWR));
    wireSeg(horBtns, (b) => (horizon = b.dataset.hor as 'month' | 'year' | 'lifetime'));

    typEl.addEventListener('change', () => {
      syncWaterCool();
      syncMaintLabel();
      render();
    });
    [areaEl, acEl, waterEl, climEl, discEl, escEl, yearsEl].forEach((el) =>
      el.addEventListener('input', render)
    );

    $('r-download')?.addEventListener('click', () => window.print());

    // NOTE: submit natively (full-page POST), the same way the contact form does.
    // an earlier ajax fetch() version silently failed on this formspree form
    // (formspree rejects the ajax path here), so calculator leads never arrived
    // while the contact form did. the native post posts straight to formspree,
    // which then redirects back to RETURN_URL (?sent=1); the check above shows the
    // thanks state on return. do not reintroduce fetch() without verifying leads
    // actually land in the inbox.
    const emailForm = root.querySelector('.email-form') as HTMLFormElement | null;
    emailForm?.addEventListener('submit', () => {
      // make sure the lead summary is current in the hidden field before posting.
      render();
    });

    // formspree bounced us back after a full-page fallback submit: show thanks.
    if (new URLSearchParams(location.search).get('sent') === '1') {
      $('email-block').hidden = true;
      $('email-sent').hidden = false;
    }

    syncWaterCool();
    syncMaintLabel();
    render();
  }
</script>
