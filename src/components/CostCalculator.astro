---
// interactive panama building cost estimator.
// one component, locale-driven. the client island lives at the bottom and
// imports the pure model from src/lib/costModel.ts.
import type { Locale } from '../i18n/strings';
import {
  CAPEX_M2,
  EUI,
  DENSITY,
  PERCAPITA,
  MAINT_M2,
  type Typology,
  type Range,
} from '../lib/costModel';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// formspree endpoint (same as the contact form) — used for lead capture
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xkoerobb';

// where formspree returns the visitor after a full-page (non-ajax) submit.
// the ajax path shows the thanks state in place without leaving; this only
// kicks in when fetch is blocked or formspree challenges the request and we
// fall back to a native form post. without it, the fallback strands the
// visitor on formspree.io and the lead looks like it "never sent".
const RETURN_URL = (locale === 'en' ? '/en/tools/cost-calculator' : '/tools/cost-calculator') + '?sent=1';

// central-value formatters for the assumptions table (server-rendered)
const c = (x: Range) => Math.round((x.low + x.high) / 2);
const money = (x: Range) => `$${c(x).toLocaleString('en-US')}`;
const money2 = (x: Range) => `$${((x.low + x.high) / 2).toFixed(2)}`;

const S = {
