    resGloss: 'res v.2 — reglamento de edificación sostenible, panama’s energy-efficiency building code.',
    energyBreakdown: 'see breakdown by end use',
    methodology: 'methodology and assumptions',
    scenRegular: 'typical building',
    scenSustainable: 'sustainable code · res v.2',
    use: {
      ac: 'air conditioning',
      lighting: 'lighting',
      plug: 'plug loads',
      other: 'other',
    },
    total: 'total',
    savingsEb: '// the proof',
    savingsLabel: 'saved per year by designing to the sustainable code.',
    opexEb: '// monthly operation',
    opexH: 'total monthly opex, side by side.',
    energyLine: 'energy',
    water: 'water + sewer',
    maintenancePH: 'maintenance (ph)',
    maintenanceHome: 'upkeep / conservación',
    lcEb: '// 30-year cost',
    lcH: 'what it costs across its useful life.',
    lcRegular: 'typical building',
    lcSustainable: 'sustainable code',
    lcSavingsLabel: 'less over 30 years by designing to the sustainable code.',
    lcNote: 'present value of construction plus 30 years of operation, discounted at 6.25 % (the SBP benchmark mortgage rate). the gap is the discounted value of designing efficiently.',
    assumptionsEb: '// what is behind the numbers',
    assumptionsH: 'the per-category averages.',
    assumptionsIntro:
      'every estimate starts from market averages and the energy-use baselines of the res v.2 sustainable-building code. these are the values the calculator uses for each building category. lighting, plug loads and other are estimated per m² and do not depend on air-conditioning; only cooling varies with the % a/c. the sustainable column reduces each end use separately (cooling −40 %, lighting −30 %, plug −5 %), within the 20–38.8 % range the code documents.',
    aCapex: 'construction (standard)',
    aEnergy: 'energy (100 % a/c)',
    aEnergyUnit: 'kwh/m²·yr',
    aWater: 'water',
    aWaterUnit: 'l/person·day',
    aOcc: 'occupancy',
    aOccUnit: 'ppl/100 m²',
    aOccCap: 'max 6 per household',
    aMaint: 'maintenance',
    aMaintUnit: '$/m²·mo',
    sourcesEb: '// sources',
    sourcesH: 'where the numbers come from.',
    srcCapex: 'construction costs (capex)',
    srcEnergy: 'electricity tariffs (asep)',
    srcCode: 'energy baseline (res v.2)',
    srcWater: 'water + sewer (idaan / asep)',
    srcMaint: 'maintenance (horizontal property)',
    disclaimer:
      'estimate for guidance only, not a quote. ranges are derived from public 2026 data (market capex, asep tariffs, idaan blocks, ph fees, and the energy-use baselines of panama’s res v.2 sustainable-building code). a real project depends on site, soil, design, and market timing. for a number you can use, let’s talk.',
  },
}[locale];

const typOrder = [
  'residential-sf',
  'residential-mf',
  'office',
  'commercial',
  'institutional',
] as const;
const useOrder = ['ac', 'lighting', 'plug', 'other'] as const;

// grouped sources (shared across locales — official document titles)
const sources = [
  {
    group: S.srcCapex,
    items: [
      { name: 'INEC · Edificaciones particulares por provincia (1er sem. 2024)', url: 'https://www.inec.gob.pa/archivos/P053342420241216160104Cuadro%2013.pdf' },
      { name: 'Contraloría · Índice de precios de materiales (IPMC, 2024–2025)', url: 'https://www.inec.gob.pa/archivos/07055475IPMC%20%20Enero%2024-25.pdf' },
      { name: 'Contraloría · Costos unitarios de acabados y remodelaciones', url: 'https://www.contraloria.gob.pa/wp-content/uploads/2024/02/2324P0-ACABADOS-Y-REMODELACIONES.pdf' },
      { name: 'Contraloría · Base de datos de costo directo', url: 'https://www.contraloria.gob.pa/wp-content/uploads/2024/07/P2-BASE-DE-DATOS-DE-COSTO-DIRECTO.pdf' },
    ],
  },
  {
    group: S.srcEnergy,
    items: [
      { name: 'ASEP · Pliego tarifario, clientes regulados (2026)', url: 'https://asep.gob.pa/wp-content/uploads/electricidad/tarifas/01_tarifas_clientes_regulados/tarifas_2023-2026/2026/abril/I_t_2026.pdf' },
      { name: 'La Prensa · Ajuste de tarifas eléctricas y fin del FET adicional (2026)', url: 'https://www.prensa.com/economia/tarifas-electricas-se-ajustan-a-partir-del-1-de-enero-de-2026-la-mayoria-de-los-usuarios-no-tendra-aumentos-en-su-factura/' },
      { name: 'Naturgy · Tarifas EDEMET / EDECHI', url: 'https://www.naturgy.com.pa/hogar/distribucion-de-electricidad/tarifas/' },
    ],
  },
  {
    group: S.srcCode,
    items: [
      { name: 'Gaceta Oficial · Guía de construcción sostenible', url: 'https://www.gacetaoficial.gob.pa/pdfTemp/28165/GacetaNo_28165_20161124.pdf' },
      { name: 'JTIA · Reglamento de edificación sostenible (RES V.2)', url: 'https://www.gacetaoficial.gob.pa/pdfTemp/29726/96966.pdf' },
      { name: 'Panamá Green Building Council · Avance de sostenibilidad', url: 'https://panamagbc.org/wp-content/uploads/2026/04/Avance-de-Sostenibilidad-en-la-edificacion-en-Panama.pdf' },
    ],
  },
  {
    group: S.srcWater,
    items: [
      { name: 'ASEP · Tarifas de agua potable y alcantarillado (IDAAN)', url: 'https://asep.gob.pa/wp-content/uploads/agua/tarifas/tarifa_1_IDAAN.pdf' },
      { name: 'ASEP · Resolución AN-3491 (agua)', url: 'https://www.asep.gob.pa/wp-content/uploads/agua/tarifas/anno_3491_agua.pdf' },
      { name: 'La Prensa · Inversión en agua potable en el presupuesto del Estado', url: 'https://www.prensa.com/sociedad/el-agua-potable-no-ha-sido-prioridad-para-el-estado/' },
    ],
  },
  {
    group: S.srcMaint,
    items: [
      { name: 'Ley 284 de 2022 · Régimen de propiedad horizontal', url: 'https://www.arispeabogado.com/p/cobrar-cuotas-mantenimiento-ph-panama.html' },
      { name: 'H&H Facility Management · Cuotas de gastos comunes', url: 'https://www.hhfacilitymanagement.com/cuotas/cuales-son-las-cuotas-de-gastos-comunes-en-un-ph/' },
